# Safe placeholders only. Copy to an ignored .env.local and replace all values.
PORT=8081
RUST_LOG=canonical_web_server=info,tower_http=info

STATIC_DIR=../canonical-marketing-site.web/dist
APP_ASSET_DIR=client/dist
APP_BASE_URL=https://app.example.invalid
APP_ALLOWED_ORIGINS=https://app.example.invalid
APP_SESSION_COOKIE=__Host-canonical_session
APP_SESSION_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_SESSION_TTL_DAYS=30
COOKIE_SECURE=true
# Per-process account throttle. Configure a stricter trusted-client-IP limit
# at the edge as well; do not trust forwarded IP headers in the application.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_GLOBAL_ATTEMPTS=500
LOGIN_RATE_LIMIT_WINDOW_SECONDS=600
LOGIN_RATE_LIMIT_MAX_KEYS=4096
# Shared per-process cap around both the Supabase password exchange and the
# local opaque-session insert. Excess attempts fail closed without queueing.
LOGIN_AUTH_MAX_CONCURRENCY=16
BEARER_AUTH_MAX_CONCURRENCY=32

# Shared Auth independently verifies the host-only browser token at the origin.
SHARED_AUTH_BROWSER_COOKIE_NAME=__Host-canonical-customer-auth
SHARED_AUTH_VERIFY_URL=https://app.example.invalid/shared-auth/auth/verify

# Dedicated quote backend. Both values are required when the serve process
# starts, including container health-smoke environments. This service token is
# shared only by the web and API runtimes and is distinct from all Shared Auth
# and Supabase credentials.
CANONICAL_API_URL=http://canonical-cloud-api.canonical-cloud.svc.cluster.local:8080
CANONICAL_WEB_SERVICE_TOKEN=replace-with-at-least-32-random-bytes

DATABASE_URL=postgresql://canonical_web_server:REPLACE_ME@db.example.invalid:5432/postgres?sslmode=verify-full
DATABASE_MAX_CONNECTIONS=10

# Optional locally; set this to the in-cluster collector's OTLP/gRPC endpoint
# in Kubernetes. Logs always remain on stdout for Promtail/Loki.
OTEL_EXPORTER_OTLP_ENDPOINT=http://dd-otel-collector.observability.svc.cluster.local:4317
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development

# No-ingress `canonical-session-revoker` process only. Use the separately
# bootstrapped role; do not mount this credential into the web process.
SESSION_REVOCATION_DATABASE_URL=postgresql://canonical_session_revoker:REPLACE_ME@db.example.invalid:5432/postgres?sslmode=verify-full
SESSION_REVOCATION_DATABASE_MAX_CONNECTIONS=2

# Used only by `canonical-web-server migrate`; never give this owner URL to the
# long-lived `serve` process.
MIGRATION_DATABASE_URL=postgresql://postgres:REPLACE_ME@db.example.invalid:5432/postgres?sslmode=verify-full
MIGRATION_DATABASE_MAX_CONNECTIONS=2

SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
