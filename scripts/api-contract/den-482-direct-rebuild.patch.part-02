-            "leader": state.metrics.leader.load(Ordering::Relaxed),
-            "atMs": now_ms(),
-        })),
+        Json(ReadinessResponse {
+            ok,
+            service: SERVICE_NAME,
+            leader: state.metrics.leader.load(Ordering::Relaxed),
+            at_ms: now_ms(),
+        }),
     )
 }
 
