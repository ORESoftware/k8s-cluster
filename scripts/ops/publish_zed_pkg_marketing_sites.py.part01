    <title>{pageTitle}</title>
  </head>
  <body
    class={bodyClass}
    style={`--accent:${site.accent};--accent-2:${site.accent2};--surface:${site.surface};`}
  >
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="ambient ambient-one" aria-hidden="true"></div>
    <div class="ambient ambient-two" aria-hidden="true"></div>
    <slot />
  </body>
</html>
'''

CODE_EXPLORER_ASTRO = r'''---
interface Example {
  language: string;
  label: string;
  filename: string;
  source_url: string;
  source_kind: "client" | "protocol" | "api" | "preview";
  code: string;
}

interface Props {
  examples: Example[];
  heading: string;
  intro: string;
  note: string;
  sourceUrl: string;
  sourceLabel: string;
  sourceStatus: string;
}

const { examples, heading, intro, note, sourceUrl, sourceLabel, sourceStatus } = Astro.props;
const explorerId = `code-${heading.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
---
<section class="code-card" data-code-explorer>
  <div class="code-card__header">
    <div>
      <p class="section-kicker">Source-backed examples</p>
      <h2>{heading}</h2>
      <p class="section-lede">{intro}</p>
    </div>
    <div class="source-summary">
      <span class="source-summary__dot" aria-hidden="true"></span>
      <div>
        <span>{sourceStatus}</span>
        <a href={sourceUrl}>{sourceLabel} <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </div>

  <div class="code-toolbar">
    <label for={explorerId}>Language</label>
    <div class="select-wrap">
      <select id={explorerId} data-code-select>
        {examples.map((example, index) => (
          <option value={String(index)}>{example.language} · {example.label}</option>
        ))}
      </select>
      <span aria-hidden="true">⌄</span>
    </div>
    <p>{note}</p>
  </div>

  <div class="code-stage" aria-live="polite">
    {examples.map((example, index) => (
      <article class="code-panel" data-code-panel data-index={String(index)} hidden={index !== 0}>
        <header>
          <div class="window-dots" aria-hidden="true"><i></i><i></i><i></i></div>
          <span>{example.filename}</span>
          <div class="code-actions">
            <span class={`source-kind source-kind--${example.source_kind}`}>{example.source_kind}</span>
            <button type="button" data-copy-code>Copy</button>
            <a href={example.source_url}>Source ↗</a>
          </div>
        </header>
        <pre tabindex="0"><code>{example.code}</code></pre>
      </article>
    ))}
  </div>
</section>

<script is:inline>
  const copyText = async (text, button) => {
    try {
      await navigator.clipboard.writeText(text);
      const previous = button.textContent;
      button.textContent = "Copied";
      window.setTimeout(() => { button.textContent = previous; }, 1400);
    } catch {
      button.textContent = "Select code";
    }
  };

  document.querySelectorAll("[data-code-explorer]").forEach((explorer) => {
    const select = explorer.querySelector("[data-code-select]");
    const panels = [...explorer.querySelectorAll("[data-code-panel]")];
    const show = (value) => {
      panels.forEach((panel) => { panel.hidden = panel.dataset.index !== value; });
    };
    select?.addEventListener("change", (event) => show(event.currentTarget.value));
    explorer.querySelectorAll("[data-copy-code]").forEach((button) => {
      button.addEventListener("click", () => {
        const code = button.closest("[data-code-panel]")?.querySelector("code")?.textContent ?? "";
        copyText(code, button);
      });
    });
  });
</script>
'''

