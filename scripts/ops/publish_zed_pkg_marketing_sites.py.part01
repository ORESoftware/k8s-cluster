  site: SiteMeta;
  title?: string;
  description?: string;
  bodyClass?: string;
}

const { site, title = site.name, description = site.description, bodyClass } = Astro.props;
const pageTitle = title === site.name ? `${site.name} — ${site.tagline}` : `${title} — ${site.name}`;
const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: site.name,
  description,
  url: site.site_url,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Web, server, mobile and desktop runtimes",
  codeRepository: site.github_url,
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content={site.surface} />
    <link rel="canonical" href={site.site_url} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
