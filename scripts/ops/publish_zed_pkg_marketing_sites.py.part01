#!/usr/bin/env python3
"""Render, publish, and verify the fixed Zed-adjacent Astro marketing fleet.

The executable target set is intentionally data-bound and test-covered.  The
script can render the complete fleet without credentials for pull-request
validation, or publish through GitHub's REST API when invoked by the protected
trusted-main runner.
"""
from __future__ import annotations

import argparse
import base64
import dataclasses
import datetime as dt
import json
import os
import re
import shutil
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path
from typing import Any, Iterable, Mapping

SCRIPT_DIR = Path(__file__).resolve().parent
SPEC_PART_GLOB = "zed_pkg_marketing_sites.json.part*"
BRANCH_NAME = "feat/astro-marketing-refresh-20260805"
MARKER = "zed-pkg-marketing-site-v1"
EXPECTED_SLUGS = (
    "agent-pontifex",
    "gha-indie-worker",
    "file-tunnel",
    "memebank",
    "daedalus-fab",
    "claritas-viz",
    "discrete-event-systems",
    "opto-sync",
    "voxletra",
    "drone-mngr",
    "shared-auth",
    "streempilot",
    "fanwaave",
    "hypesiege",
)
GENERATED_DATE = "2026-08-05"
ALLOWED_SOURCE_KINDS = {"client", "protocol", "api", "preview"}


class PublicationError(RuntimeError):
    """Bounded publication failure with a safe public message."""


class GitHubApiError(PublicationError):
    def __init__(self, status: int, method: str, path: str, message: str):
        self.status = status
        self.method = method
        self.path = path
        super().__init__(f"GitHub API {method} {path} returned {status}: {message}")


@dataclasses.dataclass(frozen=True)
class SiteResult:
    slug: str
    repository: str
    site_url: str
    created_repository: bool
    pull_request_url: str
    pull_request_number: int
    merge_sha: str
    source_verified: bool
    pages_enabled: bool
    pages_url: str | None
    pages_workflow: str
    pages_run_url: str | None
    verified: bool
    notes: tuple[str, ...] = ()

    def as_dict(self) -> dict[str, Any]:
        return dataclasses.asdict(self)


def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat()


def load_specs() -> list[dict[str, Any]]:
    try:
        parts = sorted(SCRIPT_DIR.glob(SPEC_PART_GLOB))
        if not parts:
            raise OSError(f"no specification parts matched {SPEC_PART_GLOB}")
        raw = "".join(part.read_text(encoding="utf-8") for part in parts)
        payload = json.loads(raw)
    except (OSError, json.JSONDecodeError) as exc:
        raise PublicationError(f"unable to read site specifications: {exc}") from exc
    if payload.get("schema_version") != 1:
        raise PublicationError("unsupported site specification schema")
    sites = payload.get("sites")
    if not isinstance(sites, list):
        raise PublicationError("site specifications must contain a sites list")
    validate_specs(sites)
    return sites


def validate_specs(sites: list[dict[str, Any]]) -> None:
    if len(sites) != len(EXPECTED_SLUGS):
        raise PublicationError(
            f"expected {len(EXPECTED_SLUGS)} sites, received {len(sites)}"
        )
    slugs = tuple(site.get("slug") for site in sites)
    if slugs != EXPECTED_SLUGS:
        raise PublicationError(f"site order mismatch: {slugs!r}")
    repositories: set[str] = set()
    site_urls: set[str] = set()
    for site in sites:
        required = {
            "org",
            "repo",
            "slug",
            "name",
            "monogram",
            "eyebrow",
            "tagline",
            "description",
            "accent",
            "accent2",
            "surface",
            "github_url",
            "source_url",
            "source_label",
            "source_status",
            "commit_sha",
            "commit_url",
            "commit_title",
            "stats",
            "capabilities",
            "flow",
            "signals",
            "code_heading",
            "code_intro",
            "languages_note",
            "examples",
            "site_url",
            "repository_full_name",
        }
        missing = required - site.keys()
        if missing:
            raise PublicationError(f"{site.get('slug', '<unknown>')}: missing {sorted(missing)}")
        slug = site["slug"]
        if not re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", slug):
            raise PublicationError(f"invalid site slug: {slug!r}")
        if slug.endswith("-test") or "-test." in site["repo"]:
            raise PublicationError(f"test organization entered publication set: {slug}")
        expected_repo = f"{slug}.github.io"
        if site["repo"] != expected_repo:
            raise PublicationError(f"{slug}: repository must be {expected_repo}")
        expected_url = f"https://{slug}.github.io/"
        if site["site_url"] != expected_url:
            raise PublicationError(f"{slug}: canonical URL must be {expected_url}")
        expected_full = f"{site['org']}/{site['repo']}"
        if site["repository_full_name"] != expected_full:
            raise PublicationError(f"{slug}: repository_full_name mismatch")
        if expected_full.lower() in repositories:
            raise PublicationError(f"duplicate repository: {expected_full}")
        repositories.add(expected_full.lower())
        if expected_url in site_urls:
            raise PublicationError(f"duplicate site URL: {expected_url}")
        site_urls.add(expected_url)
        for key, expected_min in (("stats", 3), ("capabilities", 3), ("flow", 4), ("signals", 3)):
            value = site[key]
            if not isinstance(value, list) or len(value) < expected_min:
                raise PublicationError(f"{slug}: {key} requires at least {expected_min} entries")
        examples = site["examples"]
        if not isinstance(examples, list) or len(examples) < 3:
            raise PublicationError(f"{slug}: at least three code examples are required")
        languages: set[str] = set()
        for example in examples:
            language = example.get("language")
            if not isinstance(language, str) or not language.strip():
                raise PublicationError(f"{slug}: invalid example language")
            if language.casefold() in languages:
                raise PublicationError(f"{slug}: duplicate example language {language}")
            languages.add(language.casefold())
            if example.get("source_kind") not in ALLOWED_SOURCE_KINDS:
                raise PublicationError(f"{slug}: invalid source kind")
            source_url = example.get("source_url")
            if not isinstance(source_url, str) or not source_url.startswith("https://github.com/"):
                raise PublicationError(f"{slug}: example source must be a GitHub URL")
            code = example.get("code")
            if not isinstance(code, str) or len(code.strip()) < 40:
                raise PublicationError(f"{slug}: code example is too small")
        for color_key in ("accent", "accent2", "surface"):
            if not re.fullmatch(r"#[0-9a-fA-F]{6}", site[color_key]):
                raise PublicationError(f"{slug}: invalid {color_key}")


def package_json(site: Mapping[str, Any]) -> str:
    payload = {
        "name": site["repo"],
        "version": "1.0.0",
        "private": True,
        "type": "module",
        "scripts": {
            "dev": "astro dev",
            "build": "astro check && astro build",
            "check": "astro check",
            "test": "node --test tests/*.test.mjs",
            "preview": "astro preview",
        },
        "dependencies": {
            "@astrojs/check": "0.9.10",
            "astro": "7.1.6",
            "typescript": "6.0.2",
        },
        "license": "MIT",
    }
    return json.dumps(payload, indent=2) + "\n"


