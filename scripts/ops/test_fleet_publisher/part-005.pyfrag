        return commit_sha, pr, True, warnings

    target_url = None
    server = os.environ.get("GITHUB_SERVER_URL")
    run_repo = os.environ.get("GITHUB_REPOSITORY")
    run_id = os.environ.get("GITHUB_RUN_ID")
    if server and run_repo and run_id:
        target_url = f"{server}/{run_repo}/actions/runs/{run_id}"
    status_body: dict[str, Any] = {
        "state": "success",
        "context": "test-fleet/bootstrap-validation",
        "description": "Exact generated tree passed bounded structural and source-pin validation",
    }
    if target_url:
        status_body["target_url"] = target_url
    client.post(f"/repos/{encoded}/statuses/{commit_sha}", status_body, expected=(201,))

    green, gate_detail = commit_gate(client, full_name, commit_sha)
    if not green:
        warnings.append(f"pull request left open: {gate_detail}")
        return commit_sha, pr, False, warnings
    try:
        merge = client.put(
            f"/repos/{encoded}/pulls/{int(pr['number'])}/merge",
            {"merge_method": "squash", "commit_title": title, "sha": commit_sha},
            expected=(200,),
        )
        if isinstance(merge, dict) and merge.get("merged") is True:
            merged = True
        else:
            warnings.append(f"pull request left open: {merge.get('message', 'merge not permitted') if isinstance(merge, dict) else 'merge not permitted'}")
    except ApiError as exc:
        if exc.status in {403, 405, 409, 422}:
            warnings.append(f"pull request left open by repository policy: HTTP {exc.status}")
        else:
            raise
    return commit_sha, pr, merged, warnings


def bootstrap_one(
    client: GitHubClient,
    resolver: SourceResolver,
    test_org: str,
    fleet: Mapping[str, Any],
    repo: Mapping[str, Any] | None,
    *,
    dotgithub: bool,
) -> RepoResult:
    production_org = str(fleet["production_org"])
    name = ".github" if dotgithub else str(repo["name"])
    result = RepoResult(test_org, f"{test_org}/{name}")
    try:
        if dotgithub:
            files, digest = render_org_dotgithub_files(test_org, production_org, fleet["repositories"])
            validate_rendered_files(test_org, name, files, digest, dotgithub=True)
            pins: list[SourcePin] = []
            purpose = f"Public organization defaults and catalog for the {test_org} test fleet."
            visibility = "public"
            title = "chore: bootstrap test-fleet organization defaults"
        else:
            assert repo is not None
            source_defs = fleet.get("sources", {})
            pins = [resolver.resolve(source_defs[ref]) for ref in repo.get("source_refs", [])]
            result.missing_sources = [pin.repository for pin in pins if not pin.exists]
            files, digest = render_repo_files(test_org, production_org, repo, pins)
            validate_rendered_files(test_org, name, files, digest, dotgithub=False)
            purpose = str(repo["purpose"])
            visibility = str(repo.get("visibility") or fleet.get("default_visibility") or "private")
            title = f"test: bootstrap {repo['name']} fleet scaffold"
        if not client.execute:
            result.action = "would-create-or-update"
            result.verified = True
            return result
        meta, created = ensure_repository(client, test_org, name, purpose, visibility)
        result.created = created
        full_name = f"{test_org}/{name}"
        if repo_marker_matches(client, full_name, digest):
            result.action = "already-current"
            result.verified = True
            return result
        default_branch = str(meta.get("default_branch") or "main")
        encoded = encode_repo_path(full_name)
        ref = client.get(f"/repos/{encoded}/git/ref/heads/{urllib.parse.quote(default_branch, safe='')}")
        base_sha = str(ref["object"]["sha"])
        branch = f"automation/test-fleet-v1-{digest[:12]}"
        if not SAFE_BRANCH.fullmatch(branch):
            raise FleetError(f"unsafe generated branch name: {branch}")
        result.branch = branch
        pr_body = (
            f"Bootstraps the bounded `{test_org}/{name}` test-fleet contract.\n\n"
            f"- production organization: `{production_org}`\n"
            f"- managed digest: `{digest}`\n"
            f"- available source pins: {sum(1 for pin in pins if pin.exists)}\n"
            f"- unavailable/planned sources: {sum(1 for pin in pins if not pin.exists)}\n"
            "- dependency modes: git submodule and Zed where declared\n"
            "- validation: structural CI plus manual authenticated integration workflow\n"
        )
        commit_sha, pr, merged, warnings = create_or_finish_pr(
            client,
            full_name,
            test_org,
            default_branch,
            base_sha,
            branch,
            files,
            pins,
            title,
            pr_body,
        )
        result.commit_sha = commit_sha
        result.pull_request_number = int(pr["number"])
        result.pull_request_url = str(pr.get("html_url") or "") or None
        result.merged = merged
        result.warnings.extend(warnings)
        if merged:
            for _ in range(12):
                if repo_marker_matches(client, full_name, digest):
                    result.verified = True
                    break
                time.sleep(1.0)
            result.action = "created-and-merged" if created else "updated-and-merged"
        else:
            result.verified = bool(commit_sha and pr)
            result.action = "created-pr-open" if created else "updated-pr-open"
        return result
    except Exception as exc:
        result.action = "failed"
        result.error = str(exc)
        return result


def markdown_report(payload: Mapping[str, Any]) -> str:
    results = payload["repositories"]
    counts: dict[str, int] = {}
    for item in results:
        counts[item["action"]] = counts.get(item["action"], 0) + 1
    lines = [
        "# Test organization repository fleet publication",
        "",
        f"- Mode: `{payload['mode']}`",
        f"- Configured test organizations: **{payload['organization_count']}**",
        f"- Configured focused test repositories: **{payload['test_repository_count']}**",
        f"- Organization `.github` repositories: **{payload['dotgithub_repository_count']}**",
        f"- Total bounded repositories: **{payload['total_repository_count']}**",
        "",
        "## Result counts",
        "",
    ]
    for key in sorted(counts):
        lines.append(f"- `{key}`: **{counts[key]}**")
    lines += ["", "## Repository results", "", "| Repository | Action | PR | Merged | Verified | Missing sources |", "| --- | --- | --- | --- | --- | --- |"]
    for item in results:
        pr = f"[#{item['pull_request_number']}]({item['pull_request_url']})" if item.get("pull_request_url") else "—"
        lines.append(
            f"| `{item['repository']}` | `{item['action']}` | {pr} | {'yes' if item['merged'] else 'no'} | {'yes' if item['verified'] else 'no'} | {len(item['missing_sources'])} |"
        )
    failures = [item for item in results if item.get("error")]
    if failures:
        lines += ["", "## Failures", ""]
        for item in failures:
            lines.append(f"- `{item['repository']}`: {item['error']}")
    missing = [item for item in results if item.get("missing_sources")]
    if missing:
        lines += ["", "## Planned or inaccessible production sources", ""]
        for item in missing:
            lines.append(f"- `{item['repository']}`: {', '.join(f'`{x}`' for x in item['missing_sources'])}")
    lines += ["", "<!-- test-org-repository-fleet-report-complete -->", ""]
    return "\n".join(lines)


def parse_args(argv: Sequence[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    default_config = Path(__file__).resolve().parents[2] / "config" / "test_org_repository_fleets" / "index.json"
    parser.add_argument("--config", type=Path, default=default_config)
    parser.add_argument("--execute", action="store_true")
    parser.add_argument("--org", action="append", default=[], help="bounded test org subset")
    parser.add_argument("--max-workers", type=int, default=3)
    parser.add_argument("--json-report", type=Path)
    parser.add_argument("--markdown-report", type=Path)
    parser.add_argument("--fail-on-open-pr", action="store_true")
    return parser.parse_args(argv)


def main(argv: Sequence[str] | None = None) -> int:
    args = parse_args(argv or sys.argv[1:])
    payload = load_config(args.config)
    selected = {x.lower() for x in args.org}
    if selected and not selected.issubset(EXPECTED_TEST_ORGS):
        raise FleetError(f"requested org subset contains non-allowlisted entries: {sorted(selected - EXPECTED_TEST_ORGS)}")
    token = os.environ.get("GH_TOKEN") or os.environ.get("GITHUB_REPOSITORY_ADMIN_TOKEN")
    if args.execute and (not token or any(ch.isspace() for ch in token)):
        raise FleetError("execute mode requires a non-whitespace GH_TOKEN or GITHUB_REPOSITORY_ADMIN_TOKEN")
    client = GitHubClient(token, execute=args.execute)
    if token:
        identity = client.get("/user")
        if not isinstance(identity, dict) or not identity.get("login"):
            raise FleetError("GitHub token identity could not be verified")
    fleets = payload["fleets"]
    chosen = [(org, fleet) for org, fleet in fleets.items() if not selected or org.lower() in selected]
    for org, _ in chosen:
        info = client.get(f"/orgs/{urllib.parse.quote(org, safe='')}", allow_404=True)
        if info is None:
            raise FleetError(f"allowlisted GitHub organization does not exist or is inaccessible: {org}")
    resolver = SourceResolver(client)
    tasks: list[tuple[str, Mapping[str, Any], Mapping[str, Any] | None, bool]] = []
    for org, fleet in chosen:
        tasks.append((org, fleet, None, True))
        tasks.extend((org, fleet, repo, False) for repo in fleet["repositories"])
    results: list[RepoResult] = []
    workers = max(1, min(int(args.max_workers), 6))
    if args.execute:
        with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as executor:
            futures = [executor.submit(bootstrap_one, client, resolver, org, fleet, repo, dotgithub=dotgithub) for org, fleet, repo, dotgithub in tasks]
            for future in concurrent.futures.as_completed(futures):
                result = future.result()
                results.append(result)
                print(f"{result.action}: {result.repository}", flush=True)
    else:
        for org, fleet, repo, dotgithub in tasks:
            result = bootstrap_one(client, resolver, org, fleet, repo, dotgithub=dotgithub)
            results.append(result)
            print(f"{result.action}: {result.repository}")
    results.sort(key=lambda item: item.repository.lower())
    test_count = sum(len(fleet["repositories"]) for _, fleet in chosen)
    report = {
        "schema_version": 1,
        "mode": "execute" if args.execute else "dry-run",
        "generated_at": dt.datetime.now(dt.timezone.utc).isoformat(),
        "organization_count": len(chosen),
        "test_repository_count": test_count,
        "dotgithub_repository_count": len(chosen),
        "total_repository_count": test_count + len(chosen),
        "repositories": [item.as_json() for item in results],
    }
    if args.json_report:
        args.json_report.parent.mkdir(parents=True, exist_ok=True)
        args.json_report.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    md = markdown_report(report)
    if args.markdown_report:
        args.markdown_report.parent.mkdir(parents=True, exist_ok=True)
        args.markdown_report.write_text(md, encoding="utf-8")
    print(md)
    failures = [item for item in results if item.error or not item.verified]
    open_prs = [item for item in results if item.pull_request_number and not item.merged]
    if failures:
        return 1
