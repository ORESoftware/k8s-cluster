    "/v1/analyze": {
      "post": {
        "operationId": "analyzeAudioSpectrum",
        "parameters": [
          {
            "description": "wav (default) or mulaw/ulaw/g711",
            "in": "query",
            "name": "format",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Sample rate for raw mulaw input; defaults to 8000",
            "in": "query",
            "name": "rate",
            "required": false,
            "schema": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/octet-stream": {
              "schema": {
                "items": {
                  "format": "int32",
                  "minimum": 0,
                  "type": "integer"
                },
                "type": "array"
              }
            }
          },
          "description": "WAV or raw G.711 mu-law audio bytes",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "FFT, spectral centroid, DTMF, RMS, and voiced-duration analysis"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Invalid audio or parameters"
          }
        },
        "security": [
          {}
        ],
        "tags": [
          "speech"
        ]
      }
    },
