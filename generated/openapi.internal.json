    "/v1/speech-to-speech": {
      "post": {
        "operationId": "translateSpeechToSpeech",
        "parameters": [
          {
            "description": "wav (default) or mulaw/ulaw/g711",
            "in": "query",
            "name": "format",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Sample rate for raw mulaw input; defaults to 8000",
            "in": "query",
            "name": "rate",
            "required": false,
            "schema": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "Required translation target language",
            "in": "query",
            "name": "target_lang",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Optional source-language hint",
            "in": "query",
            "name": "language",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "openai, gemini, or anthropic",
            "in": "query",
            "name": "provider",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Optional synthesis voice",
            "in": "query",
            "name": "voice",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "wav (default) or mp3",
            "in": "query",
            "name": "out_format",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "audio (default) or json with base64 audio",
            "in": "query",
            "name": "respond",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/octet-stream": {
              "schema": {
                "items": {
                  "format": "int32",
                  "minimum": 0,
                  "type": "integer"
                },
                "type": "array"
              }
            }
          },
          "description": "Source speech audio bytes",
          "required": true
        },
        "responses": {
          "200": {
            "description": "Translated audio bytes or JSON pipeline result"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Invalid audio, provider, language, or output format"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "No transcribable speech"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Speech or translation provider failed"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Provider or concurrency capacity unavailable"
          }
        },
        "security": [
          {}
        ],
        "tags": [
          "speech"
        ]
      }
    },
    "/v1/stt": {
      "post": {
        "operationId": "transcribeAudio",
        "parameters": [
