        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Persisted transcription result"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Invalid audio or parameters"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "No signal above the silence threshold"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Speech provider failed"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Speech provider or concurrency capacity unavailable"
          }
        },
        "security": [
          {}
        ],
        "tags": [
          "speech"
