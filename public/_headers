# Security headers for the static Sonus Auris site.
#
# WARNING: the current deploy target is GitHub Pages (see astro.config.mjs +
# .github/workflows/deploy.yml), and GitHub Pages does NOT honor `_headers` —
# this file is published as an inert text file at /_headers and NONE of the
# response headers below are actually served. `src/layouts/Base.astro` therefore
# ships a CSP meta element for the active-content directives browsers support in
# markup. HSTS, frame-ancestors, X-Frame-Options, COOP, CORP, nosniff, and
# Permissions-Policy still require a CDN/origin that emits real response headers.
#
# Keep this policy semantically aligned with the meta CSP and generated/browser
# tests. When hosting moves to Cloudflare Pages, Netlify, or an nginx/CDN front
# door, this file can become the canonical header policy without widening the
# site.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; script-src 'none'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; media-src 'self' blob:; connect-src 'none'; frame-src 'none'; frame-ancestors 'none'; worker-src 'none'; manifest-src 'self'; form-action 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: accelerometer=(), browsing-topics=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none
