{
  "name": "t2v-web-e2e",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser end-to-end tests for the t2v web dashboard and generated API contract.",
  "scripts": {
    "test": "playwright test && npm run test:browser-smoke",
    "test:browser-smoke": "node --test --test-concurrency=1 --test-timeout=300000 site-playwright.test.mjs site-puppeteer.test.mjs site-selenium.test.mjs",
    "test:playwright-smoke": "node --test --test-timeout=300000 site-playwright.test.mjs",
    "test:puppeteer-smoke": "node --test --test-timeout=300000 site-puppeteer.test.mjs",
    "test:selenium-smoke": "node --test --test-timeout=300000 site-selenium.test.mjs",
    "install-browsers": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "playwright": "^1.48.0",
    "puppeteer": "^25.3.0",
    "selenium-webdriver": "^4.25.0"
  }
}
