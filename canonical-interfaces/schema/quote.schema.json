{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CanonicalQuote",
  "description": "Typed request, asynchronous status, and estimate payloads for the canonical.plus compliance quote workflow.",
  "$defs": {
    "QuoteRequest": {
      "type": "object",
      "description": "Authenticated request to generate a bounded compliance-services quote.",
      "required": [
        "organizationName",
        "contactName",
        "contactEmail",
        "employeeCount",
        "frameworks",
        "currentStage",
        "infrastructure",
        "dataSensitivity",
        "hasSecurityProgram",
        "hasPolicies",
        "hasRiskAssessment",
        "hasIncidentResponsePlan",
        "hasVendorManagement",
        "answersVersion"
      ],
      "additionalProperties": false,
      "properties": {
        "organizationName": {"type":"string","minLength":1,"maxLength":200,"description":"Legal or commonly used organization name."},
        "contactName": {"type":"string","minLength":1,"maxLength":160,"description":"Primary contact for the quote."},
        "contactEmail": {"type":"string","format":"email","maxLength":320,"description":"Verified follow-up email. Authentication and owner identity are derived from the accepted credential, not this field."},
        "website": {"type":"string","format":"uri","maxLength":2048,"description":"Optional public organization website."},
        "employeeCount": {"type":"integer","minimum":1,"maximum":1000000,"description":"Approximate number of employees and long-term contractors."},
        "annualRevenueBand": {"type":"string","pattern":"^(pre_revenue|under_1m|1m_10m|10m_50m|50m_250m|over_250m|prefer_not_to_say)$","description":"Optional bounded annual-revenue band used only for scoping."},
        "frameworks": {"type":"array","minItems":1,"maxItems":12,"uniqueItems":true,"items":{"type":"string","enum":["soc2_type_1","soc2_type_2","nist_csf_2","nist_800_53","hipaa","iso_27001","pci_dss_4","fedramp","gdpr","custom"]},"description":"Compliance frameworks requested for the engagement."},
        "currentStage": {"type":"string","pattern":"^(exploring|readiness|remediation|audit_ready|renewal)$","description":"Current compliance-program stage."},
        "infrastructure": {"type":"array","minItems":1,"maxItems":12,"uniqueItems":true,"items":{"type":"string","enum":["aws","azure","gcp","supabase","on_prem","colocation","saas_only","multi_cloud","other"]},"description":"Primary hosting and application infrastructure."},
        "dataSensitivity": {"type":"array","minItems":1,"maxItems":12,"uniqueItems":true,"items":{"type":"string","enum":["public","internal","confidential","pii","phi","pci","government_cui","customer_secrets","other"]},"description":"Highest-sensitivity data categories in scope."},
        "targetDate": {"type":"string","format":"date","description":"Optional target date for readiness, attestation, or authorization."},
        "hasSecurityProgram": {"type":"boolean","description":"Whether a named security owner and operating security program exist."},
        "hasPolicies": {"type":"boolean","description":"Whether reviewed security and privacy policies currently exist."},
        "hasRiskAssessment": {"type":"boolean","description":"Whether a current documented risk assessment exists."},
        "hasIncidentResponsePlan": {"type":"boolean","description":"Whether an incident-response plan exists and has been exercised."},
        "hasVendorManagement": {"type":"boolean","description":"Whether third-party risk and vendor review processes exist."},
        "notes": {"type":"string","maxLength":5000,"description":"Optional additional scoping details; secrets and regulated records must not be submitted."},
        "contextKey": {"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{0,127}$","description":"Optional allow-listed canonical_context key selected by the server; defaults to quote-analysis.","maxLength":128,"default":"quote-analysis"},
        "answersVersion": {"type":"integer","const":1,"minimum":1,"maximum":1,"description":"Questionnaire schema version; only version 1 is accepted."}
      }
    },
    "QuoteSubmissionResponse": {
      "type":"object","description":"Accepted response from POST /api/v1/quotes.","required":["quoteId","status","streamUrl","createdAt"],"additionalProperties":false,
      "properties": {
        "quoteId":{"type":"string","format":"uuid","description":"Server-generated quote identifier."},
        "status":{"type":"string","enum":["queued","analyzing","ready","failed"],"description":"Current asynchronous quote state."},
        "streamUrl":{"type":"string","format":"uri-reference","maxLength":2048,"description":"Authenticated WebSocket URL or relative path for quote progress."},
        "createdAt":{"type":"string","format":"date-time","description":"RFC 3339 creation timestamp."}
      }
    },
    "QuoteEstimate": {
      "type":"object","description":"Structured Gemini-assisted estimate persisted after server-side validation.","required":["quoteId","status","currency","lowerBoundCents","upperBoundCents","durationWeeksLow","durationWeeksHigh","confidence","summary","assumptions","gaps","nextSteps","frameworks","model","contextVersion","createdAt"],"additionalProperties":false,
      "properties": {
        "quoteId":{"type":"string","format":"uuid","description":"Quote identifier."},
        "status":{"type":"string","pattern":"^ready$","description":"Terminal estimate status."},
        "currency":{"type":"string","pattern":"^[A-Z]{3}$","description":"ISO 4217 currency code, initially USD."},
        "lowerBoundCents":{"type":"integer","minimum":0,"maximum":100000000000,"description":"Inclusive lower estimate bound in minor currency units."},
        "upperBoundCents":{"type":"integer","minimum":0,"maximum":100000000000,"description":"Inclusive upper estimate bound in minor currency units."},
        "durationWeeksLow":{"type":"integer","minimum":1,"maximum":260,"description":"Optimistic delivery duration in weeks."},
        "durationWeeksHigh":{"type":"integer","minimum":1,"maximum":260,"description":"Conservative delivery duration in weeks."},
        "confidence":{"type":"string","pattern":"^(low|medium|high)$","description":"Confidence after context and questionnaire completeness checks."},
        "summary":{"type":"string","minLength":1,"maxLength":4000,"description":"Customer-facing estimate summary."},
        "assumptions":{"type":"array","maxItems":50,"items":{"type":"string","maxLength":1000},"description":"Material assumptions used to construct the range."},
        "gaps":{"type":"array","maxItems":50,"items":{"type":"string","maxLength":1000},"description":"Likely readiness gaps that affect cost or schedule."},
        "nextSteps":{"type":"array","maxItems":25,"items":{"type":"string","maxLength":1000},"description":"Recommended next actions in priority order."},
        "frameworks":{"type":"array","minItems":1,"maxItems":12,"uniqueItems":true,"items":{"type":"string","enum":["soc2_type_1","soc2_type_2","nist_csf_2","nist_800_53","hipaa","iso_27001","pci_dss_4","fedramp","gdpr","custom"]},"description":"Frameworks included in this estimate."},
        "model":{"type":"string","maxLength":120,"description":"Configured Gemini model identifier used for analysis."},
        "contextVersion":{"type":"string","maxLength":200,"description":"Immutable combined-context version or digest."},
        "createdAt":{"type":"string","format":"date-time","description":"RFC 3339 estimate timestamp."}
      }
    },
    "QuoteStatusEvent": {
      "type":"object","description":"Authenticated WebSocket progress message for one quote.","required":["quoteId","sequence","stage","message","terminal","occurredAt"],"additionalProperties":false,
      "properties": {
        "quoteId":{"type":"string","format":"uuid","description":"Quote identifier."},
        "sequence":{"type":"string","pattern":"^(0|[1-9][0-9]{0,18})$","description":"Monotonic decimal-string event sequence."},
        "stage":{"type":"string","enum":["queued","loading_context","analyzing","validating","ready","failed"],"description":"Bounded processing stage."},
        "message":{"type":"string","maxLength":1000,"description":"Human-readable progress summary without sensitive prompt content."},
        "terminal":{"type":"boolean","description":"True when no later state is expected."},
        "estimate":{"$ref":"#/$defs/QuoteEstimate","description":"Present only for a successful ready event."},
        "occurredAt":{"type":"string","format":"date-time","description":"RFC 3339 timestamp for the persisted event."},
        "problem":{"$ref":"#/$defs/QuoteProblem","description":"Present only when the event reports a safe public failure."}
      }
    },
    "QuoteProblem": {
      "type":"object","description":"Bounded public error payload for quote endpoints.","required":["code","message","requestId"],"additionalProperties":false,
      "properties": {
        "code":{"type":"string","pattern":"^(invalid_request|unauthorized|forbidden|not_found|conflict|idempotency_key_reused|rate_limited|context_unavailable|storage_unavailable|upstream_unavailable|analysis_failed|internal)$","description":"Stable machine-readable error code."},
        "message":{"type":"string","maxLength":1000,"description":"Safe human-readable error detail."},
        "requestId":{"type":"string","maxLength":128,"description":"Request correlation identifier."}
      }
    },
    "QuoteSummary": {
      "type":"object","description":"Owner-scoped list item for a compliance quote.","required":["quoteId","status","organizationName","frameworks","createdAt","updatedAt"],"additionalProperties":false,
      "properties": {
        "quoteId":{"type":"string","format":"uuid","description":"Server-generated quote identifier."},
        "status":{"type":"string","enum":["queued","analyzing","ready","failed"],"description":"Current asynchronous quote state."},
        "organizationName":{"type":"string","minLength":1,"maxLength":200,"description":"Organization name from the accepted request."},
        "frameworks":{"type":"array","minItems":1,"maxItems":12,"uniqueItems":true,"items":{"type":"string","enum":["soc2_type_1","soc2_type_2","nist_csf_2","nist_800_53","hipaa","iso_27001","pci_dss_4","fedramp","gdpr","custom"]},"description":"Frameworks included in the request."},
        "createdAt":{"type":"string","format":"date-time","description":"RFC 3339 creation timestamp."},
        "updatedAt":{"type":"string","format":"date-time","description":"RFC 3339 last-status timestamp."},
        "estimate":{"$ref":"#/$defs/QuoteEstimate","description":"Present only when the quote is ready."}
      }
    },
    "QuoteDetail": {
      "type":"object","description":"Owner-scoped authoritative REST representation of one quote.","required":["quoteId","status","request","eventsUrl","createdAt","updatedAt"],"additionalProperties":false,
      "properties": {
        "quoteId":{"type":"string","format":"uuid","description":"Server-generated quote identifier."},
        "status":{"type":"string","enum":["queued","analyzing","ready","failed"],"description":"Current asynchronous quote state."},
        "request":{"$ref":"#/$defs/QuoteRequest","description":"Normalized accepted questionnaire."},
        "eventsUrl":{"type":"string","format":"uri-reference","maxLength":2048,"description":"Authenticated WebSocket URL or relative path for persisted status events."},
        "createdAt":{"type":"string","format":"date-time","description":"RFC 3339 creation timestamp."},
        "updatedAt":{"type":"string","format":"date-time","description":"RFC 3339 last-status timestamp."},
        "estimate":{"$ref":"#/$defs/QuoteEstimate","description":"Present only when the quote is ready."},
        "problem":{"$ref":"#/$defs/QuoteProblem","description":"Present only when the quote is failed."}
      }
    },
    "QuoteListQuery": {
      "type":"object","description":"Bounded owner-scoped list query for GET /api/v1/quotes.","additionalProperties":false,
      "properties": {
        "cursor":{"type":"string","minLength":1,"maxLength":4096,"description":"Opaque owner-bound pagination cursor."},
        "limit":{"type":"integer","minimum":1,"maximum":100,"default":25,"description":"Requested page size; the server clamps to 1 through 100."}
      }
    },
    "QuoteListResponse": {
      "type":"object","description":"Owner-scoped quote list response.","required":["quotes"],"additionalProperties":false,
      "properties": {
        "quotes":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/QuoteSummary"},"description":"Quotes in descending creation order."},
        "nextCursor":{"type":"string","minLength":1,"maxLength":4096,"description":"Opaque cursor for the next page when more results exist."}
      }
    },
    "QuoteRetryResponse": {
      "type":"object","description":"Accepted response after retrying a failed quote.","required":["quoteId","status","streamUrl","updatedAt"],"additionalProperties":false,
      "properties": {
        "quoteId":{"type":"string","format":"uuid","description":"Quote identifier."},
        "status":{"type":"string","enum":["queued"],"description":"A successful retry requeues the quote."},
        "streamUrl":{"type":"string","format":"uri-reference","maxLength":2048,"description":"Authenticated WebSocket URL or relative path for quote progress."},
        "updatedAt":{"type":"string","format":"date-time","description":"RFC 3339 retry acceptance timestamp."}
      }
    }
  }
}
