/target
.DS_Store
*.log
# --- environment / secrets (sops + age) -------------------------------------
# Only env/enc/*.env.enc is tracked. Every plaintext form stays out of git;
# `just env-check` enforces it. See env/README.md.
# (`*.env` already matches at any depth — `**/*.env` is stated for clarity.)
.env
.env.*
*.env
**/*.env
env/dec/
!.env.example

# age private keys — never commit these.
*.agekey
*.age-key
keys.txt
sops-private*.txt


# Built Astro site. NOT committed — the deployment builds it in-pod (node
# initContainer) and hands it to this backend via STATIC_DIR. For local dev,
# point STATIC_DIR at ../fiducia-marketing.web/dist (or run `npm run sync` there).
/static
/dist

# Browser E2E deps (playwright/puppeteer/@fiducia/test-config)
node_modules/
package-lock.json

# Scratch / git worktrees (tmp/worktrees/*)
tmp/

# --- hardened baseline (auto) ---
Thumbs.db
*.swp
*~
.direnv/
target/
**/*.rs.bk
*.pdb
.cargo-target-*/
tmp
temp
tmp/worktrees
temp/worktrees
