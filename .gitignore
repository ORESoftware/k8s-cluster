# --- environment / secrets (sops + age) -------------------------------------
# Only env/enc/*.env.enc is tracked. Every plaintext form stays out of git;
# `just env-check` enforces it. See env/README.md.
# (`*.env` already matches at any depth — `**/*.env` is stated for clarity.)
.env
.env.*
*.env
**/*.env
env/dec/
!.env.example

# age private keys — never commit these.
*.agekey
*.age-key
keys.txt
sops-private*.txt

.direnv/

# Scratch space (git worktrees, build scratch, etc.) — see agents.md
tmp/

# --- hardened baseline (auto) ---
.DS_Store
Thumbs.db
*.log
*.swp
*~
node_modules/
dist/
.next/
.astro/
.cache/
coverage/
*.tsbuildinfo
pkg/
pkg-node/
*-debug.log*
tmp
temp
tmp/worktrees
temp/worktrees
