      "root": "remote/worker-sdks/python/durable-worker",
      "marker": "pyproject.toml",
      "minimumRuntime": "python>=3.11",
      "nativeCheck": "PYTHONPATH=remote/worker-sdks/python/durable-worker/src python3 -m unittest discover -s remote/worker-sdks/python/durable-worker/tests -v",
      "capabilities": [
        "retry-safety",
        "transport-containment",
        "lease-fencing"
      ]
    },
    {
      "language": "go",
      "root": "remote/worker-sdks/go/durable-worker",
      "marker": "go.mod",
      "minimumRuntime": "go>=1.23",
      "nativeCheck": "cd remote/worker-sdks/go/durable-worker && go test ./... -race -count=1",
