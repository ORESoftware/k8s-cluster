    {
      "language": "dart",
      "root": "remote/worker-sdks/dart/durable_worker",
      "marker": "pubspec.yaml",
      "minimumRuntime": "dart>=3.4<4",
      "nativeCheck": "cd remote/worker-sdks/dart/durable_worker && dart pub get --enforce-lockfile && dart analyze --fatal-infos --fatal-warnings && dart run tool/test.dart",
