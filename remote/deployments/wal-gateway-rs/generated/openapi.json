{
  "components": {
    "schemas": {
      "HealthResponse": {
        "properties": {
          "atMs": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "leader": {
            "type": "boolean"
          },
          "ok": {
            "type": "boolean"
          },
          "polls": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "rowsPublished": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "service": {
            "type": "string"
          }
        },
        "required": [
          "ok",
          "service",
          "leader",
          "polls",
          "rowsPublished",
          "atMs"
        ],
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "atMs": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "leader": {
            "type": "boolean"
          },
          "ok": {
            "type": "boolean"
          },
          "service": {
            "type": "string"
          }
        },
        "required": [
          "ok",
          "service",
          "leader",
          "atMs"
        ],
        "type": "object"
      },
      "RootResponse": {
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "schemaVersion": {
            "type": "string"
          },
          "service": {
            "type": "string"
          }
        },
        "required": [
          "ok",
          "service",
          "schemaVersion"
        ],
        "type": "object"
      },
      "RuntimeConfigApplyReason": {
        "description": "Why this push happened. 'cron' = periodic sweep, 'admin' = on-demand UI button, 'register' = subscriber just joined, 'manual' = explicit API call, 'initial' = subscriber boot-time pull.",
        "enum": [
          "cron",
          "admin",
          "register",
          "manual",
          "initial"
        ],
        "type": "string"
      },
      "RuntimeConfigApplyRequest": {
        "description": "Payload POSTed by the control plane to each subscriber's /internal/update-runtime-config endpoint.",
        "properties": {
          "pushId": {
            "description": "Opaque id for tracing (UUIDv4 recommended).",
            "type": "string"
          },
          "reason": {
            "$ref": "#/components/schemas/RuntimeConfigApplyReason"
          },
          "snapshot": {
            "$ref": "#/components/schemas/RuntimeConfigSnapshot"
          }
        },
        "required": [
          "pushId",
          "reason",
          "snapshot"
        ],
        "type": "object"
      },
      "RuntimeConfigApplyResponse": {
        "description": "What a subscriber returns to the control plane after applying (or rejecting) a snapshot.",
        "properties": {
          "appliedAt": {
            "type": "string"
          },
          "appliedVersion": {
            "description": "Snapshot version the subscriber now holds. May equal previously-held version if no change was needed.",
            "format": "int64",
            "type": "integer"
          },
          "errors": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "ignoredVersion": {
            "description": "Older snapshot version ignored when stale=true.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "ok": {
            "type": "boolean"
          },
          "previousVersion": {
            "description": "Snapshot version the subscriber held before applying (or 0 on initial apply).",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "service": {
            "description": "Subscriber-reported service name (matches the subscriber registration).",
            "type": "string"
          },
          "stale": {
            "description": "True when the subscriber acknowledged but ignored an older snapshot.",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "ok",
          "service",
          "appliedAt",
          "appliedVersion"
        ],
        "type": "object"
      },
      "RuntimeConfigEntry": {
        "description": "One config entry. `value` is a free-form JSON value so callers can ship simple strings/numbers or richer JSON objects without rev'ing the schema.",
        "properties": {
          "env": {
            "$ref": "#/components/schemas/RuntimeConfigEnv"
          },
          "key": {
            "description": "Stable per-scope key. Recommend SCREAMING_SNAKE_CASE so it can sit alongside env vars.",
            "type": "string"
          },
          "labels": {
            "description": "Optional free-form labels (e.g. 'feature-flag', 'rate-limit').",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "meta": {
            "description": "Optional metadata: who-changed-it, change-reason, jira ticket, etc."
          },
          "scope": {
            "description": "Target service or logical grouping (e.g. 'dd-remote-web-home', 'dd-dev-server', or 'default' for cluster-wide values).",
            "type": "string"
          },
          "updatedAt": {
            "description": "ISO-8601 UTC instant at which the control plane wrote this version.",
            "type": "string"
          },
          "value": {
            "description": "Arbitrary JSON value. Producers SHOULD NOT embed secrets here; this payload is logged at every subscriber."
          },
          "version": {
            "description": "Monotonic per-entry version; the control plane bumps this whenever the value changes.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "env",
          "scope",
          "key",
          "version",
          "updatedAt"
        ],
        "type": "object"
      },
      "RuntimeConfigEnv": {
        "description": "Top-level namespace for every runtime-config record. Every Redis key, every snapshot, every subscriber registration is scoped to exactly one env. Stage and prod are isolated.",
        "enum": [
          "stage",
          "prod"
        ],
        "type": "string"
      },
      "RuntimeConfigErrorResponse": {
        "properties": {
          "error": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "error"
        ],
        "type": "object"
      },
      "RuntimeConfigResetResponse": {
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "type": "object"
      },
      "RuntimeConfigSnapshot": {
        "description": "The full set of active entries that apply to a given (env, scope) at a point in time. Subscribers receive this on every push.",
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/components/schemas/RuntimeConfigEntry"
            },
            "type": "array"
          },
          "env": {
            "$ref": "#/components/schemas/RuntimeConfigEnv"
          },
          "generatedAt": {
            "type": "string"
          },
          "scope": {
            "description": "Subscriber-targeted scope (e.g. 'dd-remote-web-home'). Use '*' for fan-out across all scopes.",
            "type": "string"
          },
          "snapshotVersion": {
            "description": "Monotonic env generation assigned by the control plane. Subscribers MAY ignore an older apply if they already store a greater version.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "env",
          "scope",
          "generatedAt",
          "snapshotVersion",
          "entries"
        ],
        "type": "object"
      },
      "RuntimeConfigSnapshotResponse": {
        "properties": {
          "appliedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "entries": {
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "env": {
            "type": [
              "string",
              "null"
            ]
          },
          "lastPushId": {
            "type": [
              "string",
              "null"
            ]
          },
          "lastReason": {
            "type": [
              "string",
              "null"
            ]
          },
          "scope": {
            "type": [
              "string",
              "null"
            ]
          },
          "service": {
            "type": [
              "string",
              "null"
            ]
          },
          "snapshotVersion": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "snapshotVersion",
          "entries"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "runtime_config_server_auth": {
        "description": "Shared server-to-server secret configured through RUNTIME_CONFIG_SERVER_SECRET.",
        "in": "header",
        "name": "x-server-auth",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Typed operational and runtime-configuration API for the Postgres-to-NATS WAL gateway. The document is composed from the exact handlers registered by the live Axum routers.",
    "title": "wal-gateway-rs API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "getWalGatewayDescriptor",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RootResponse"
                }
              }
            },
            "description": "Stable public service descriptor"
          }
        },
        "security": [
          {}
        ],
        "tags": [
          "service"
        ],
        "x-dd-auth": "public",
        "x-dd-visibility": "public"
      }
    },
    "/api/docs": {
      "get": {
        "operationId": "getWalGatewayPublicApiReference",
        "responses": {
          "200": {
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Interactive Scalar reference for the fail-closed public contract"
          }
        },
        "security": [
          {}
        ],
        "tags": [
          "documentation"
        ],
        "x-dd-auth": "public",
        "x-dd-visibility": "public"
      }
    },
    "/api/docs.json": {
      "get": {
        "operationId": "getWalGatewayPublicOpenApiDocumentCompatibilityAlias",
        "responses": {
          "200": {
            "content": {
              "application/vnd.oai.openapi+json;version=3.1": {}
            },
            "description": "Compatibility alias for the fail-closed public OpenAPI 3.1 contract"
          }
        },
        "security": [
          {}
        ],
        "tags": [
          "documentation"
        ],
        "x-dd-auth": "public",
        "x-dd-visibility": "public"
      }
    },
    "/docs/api": {
      "get": {
        "operationId": "getWalGatewayPublicApiReferenceCompatibilityAlias",
        "responses": {
          "200": {
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Compatibility alias for the public Scalar API reference"
          }
        },
        "security": [
          {}
        ],
        "tags": [
          "documentation"
        ],
        "x-dd-auth": "public",
        "x-dd-visibility": "public"
      }
    },
    "/healthz": {
      "get": {
        "operationId": "getWalGatewayHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Process health and bounded internal counters"
          }
        },
        "security": [
          {}
        ],
        "tags": [
          "operations"
        ],
        "x-dd-auth": "cluster-network-policy",
        "x-dd-visibility": "internal"
      }
    },
    "/internal/runtime-config": {
      "get": {
        "operationId": "getRuntimeConfigSnapshot",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeConfigSnapshotResponse"
                }
              }
            },
            "description": "Current in-process runtime configuration snapshot"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeConfigErrorResponse"
                }
              }
            },
            "description": "Missing or invalid server authentication"
          }
        },
        "security": [
          {
            "runtime_config_server_auth": []
          }
        ],
        "tags": [
          "runtime-config"
        ],
        "x-dd-visibility": "internal"
      }
    },
    "/internal/runtime-config/reset": {
      "post": {
        "operationId": "resetRuntimeConfigSnapshot",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeConfigResetResponse"
                }
              }
            },
            "description": "Runtime overrides cleared"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeConfigErrorResponse"
                }
              }
            },
            "description": "Missing or invalid server authentication"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeConfigErrorResponse"
                }
              }
            },
            "description": "Runtime-config authentication is not configured"
          }
        },
        "security": [
          {
            "runtime_config_server_auth": []
          }
        ],
        "tags": [
          "runtime-config"
        ],
        "x-dd-visibility": "internal"
      }
    },
    "/internal/update-runtime-config": {
      "post": {
        "operationId": "applyRuntimeConfigSnapshot",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RuntimeConfigApplyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeConfigApplyResponse"
                }
              }
            },
            "description": "Snapshot applied or acknowledged as stale"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeConfigErrorResponse"
                }
              }
            },
            "description": "Missing or invalid server authentication"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeConfigErrorResponse"
                }
              }
            },
            "description": "Runtime-config authentication is not configured"
          }
        },
        "security": [
          {
            "runtime_config_server_auth": []
          }
        ],
        "tags": [
          "runtime-config"
        ],
        "x-dd-visibility": "internal"
      }
    },
    "/metrics": {
      "get": {
        "operationId": "getWalGatewayPrometheusMetrics",
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Prometheus text exposition"
          }
        },
        "security": [
          {}
        ],
        "tags": [
          "operations"
        ],
        "x-dd-auth": "cluster-network-policy",
        "x-dd-visibility": "internal"
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getWalGatewayPublicOpenApiDocument",
        "responses": {
          "200": {
            "content": {
              "application/vnd.oai.openapi+json;version=3.1": {}
            },
            "description": "Fail-closed public OpenAPI 3.1 contract"
          }
        },
        "security": [
          {}
        ],
        "tags": [
          "documentation"
        ],
        "x-dd-auth": "public",
        "x-dd-visibility": "public"
      }
    },
    "/readyz": {
      "get": {
        "operationId": "getWalGatewayReadiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Gateway is configured to reach JetStream"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "A required gateway dependency is not configured"
          }
        },
        "security": [
          {}
        ],
        "tags": [
          "operations"
        ],
        "x-dd-auth": "cluster-network-policy",
        "x-dd-visibility": "internal"
      }
    }
  },
  "tags": [],
  "x-dd-contract-scope": "internal",
  "x-dd-service": "wal-gateway-rs",
  "x-dd-source-of-truth": "utoipa-axum"
}
