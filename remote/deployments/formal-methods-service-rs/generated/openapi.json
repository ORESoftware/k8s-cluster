{
  "components": {
    "schemas": {
      "ErrorResponse": {
        "properties": {
          "code": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "code"
        ],
        "type": "object"
      },
      "GitRef": {
        "properties": {
          "ref": {
            "description": "Branch name.",
            "type": "string"
          },
          "repo": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Repository"
              }
            ]
          },
          "sha": {
            "type": "string"
          }
        },
        "required": [
          "ref",
          "sha"
        ],
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "PullRequest": {
        "properties": {
          "base": {
            "$ref": "#/components/schemas/GitRef"
          },
          "draft": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "head": {
            "$ref": "#/components/schemas/GitRef"
          },
          "html_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "number": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "state": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "number",
          "state",
          "title",
          "head",
          "base"
        ],
        "type": "object"
      },
      "PullRequestAction": {
        "description": "Action on a `pull_request` event. We treat anything outside of the\n\"code changed\" subset as a no-op.",
        "enum": [
          "opened",
          "reopened",
          "synchronize",
          "ready_for_review",
          "edited",
          "closed",
          "assigned",
          "unassigned",
          "labeled",
          "unlabeled",
          "review_requested",
          "review_request_removed",
          "converted_to_draft",
          "locked",
          "unlocked",
          "milestoned",
          "demilestoned",
          "auto_merge_enabled",
          "auto_merge_disabled",
          "dequeued",
          "enqueued",
          "other"
        ],
        "type": "string"
      },
      "PullRequestEvent": {
        "properties": {
          "action": {
            "$ref": "#/components/schemas/PullRequestAction"
          },
          "number": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "pull_request": {
            "$ref": "#/components/schemas/PullRequest"
          },
          "repository": {
            "$ref": "#/components/schemas/Repository"
          }
        },
        "required": [
          "action",
          "number",
          "pull_request",
          "repository"
        ],
        "type": "object"
      },
      "ReadyDeliveryDedupe": {
        "properties": {
          "tracked": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "tracked"
        ],
        "type": "object"
      },
      "ReadyPathFilter": {
        "properties": {
          "active": {
            "type": "boolean"
          },
          "prefixes": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "active",
          "prefixes"
        ],
        "type": "object"
      },
      "ReadyRepoAllowlist": {
        "properties": {
          "allow_all": {
            "type": "boolean"
          }
        },
        "required": [
          "allow_all"
        ],
        "type": "object"
      },
      "ReadyResponse": {
        "properties": {
          "analyzers": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "delivery_dedupe": {
            "$ref": "#/components/schemas/ReadyDeliveryDedupe"
          },
          "github_token_configured": {
            "type": "boolean"
          },
          "path_filter": {
            "$ref": "#/components/schemas/ReadyPathFilter"
          },
          "repo_allowlist": {
            "$ref": "#/components/schemas/ReadyRepoAllowlist"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "analyzers",
          "github_token_configured",
          "repo_allowlist",
          "path_filter",
          "delivery_dedupe"
        ],
        "type": "object"
      },
      "RepoOwner": {
        "properties": {
          "login": {
            "type": "string"
          }
        },
        "required": [
          "login"
        ],
        "type": "object"
      },
      "Repository": {
        "properties": {
          "clone_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "full_name": {
            "type": "string"
          },
          "html_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "owner": {
            "$ref": "#/components/schemas/RepoOwner"
          },
          "private": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "full_name",
          "owner"
        ],
        "type": "object"
      },
      "RuntimeConfigApplyReason": {
        "description": "Why this push happened. 'cron' = periodic sweep, 'admin' = on-demand UI button, 'register' = subscriber just joined, 'manual' = explicit API call, 'initial' = subscriber boot-time pull.",
        "enum": [
          "cron",
          "admin",
          "register",
          "manual",
          "initial"
        ],
        "type": "string"
      },
      "RuntimeConfigApplyRequest": {
        "description": "Payload POSTed by the control plane to each subscriber's /internal/update-runtime-config endpoint.",
        "properties": {
          "pushId": {
            "description": "Opaque id for tracing (UUIDv4 recommended).",
            "type": "string"
          },
          "reason": {
            "$ref": "#/components/schemas/RuntimeConfigApplyReason"
          },
          "snapshot": {
            "$ref": "#/components/schemas/RuntimeConfigSnapshot"
          }
        },
        "required": [
          "pushId",
          "reason",
          "snapshot"
        ],
        "type": "object"
      },
      "RuntimeConfigApplyResponse": {
        "description": "What a subscriber returns to the control plane after applying (or rejecting) a snapshot.",
        "properties": {
          "appliedAt": {
            "type": "string"
          },
          "appliedVersion": {
            "description": "Snapshot version the subscriber now holds. May equal previously-held version if no change was needed.",
            "format": "int64",
            "type": "integer"
          },
          "errors": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "ignoredVersion": {
            "description": "Older snapshot version ignored when stale=true.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "ok": {
            "type": "boolean"
          },
          "previousVersion": {
            "description": "Snapshot version the subscriber held before applying (or 0 on initial apply).",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "service": {
            "description": "Subscriber-reported service name (matches the subscriber registration).",
            "type": "string"
          },
          "stale": {
            "description": "True when the subscriber acknowledged but ignored an older snapshot.",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "ok",
          "service",
          "appliedAt",
          "appliedVersion"
        ],
        "type": "object"
      },
      "RuntimeConfigEntry": {
        "description": "One config entry. `value` is a free-form JSON value so callers can ship simple strings/numbers or richer JSON objects without rev'ing the schema.",
        "properties": {
          "env": {
            "$ref": "#/components/schemas/RuntimeConfigEnv"
          },
          "key": {
            "description": "Stable per-scope key. Recommend SCREAMING_SNAKE_CASE so it can sit alongside env vars.",
            "type": "string"
          },
          "labels": {
            "description": "Optional free-form labels (e.g. 'feature-flag', 'rate-limit').",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "meta": {
            "description": "Optional metadata: who-changed-it, change-reason, jira ticket, etc."
          },
          "scope": {
            "description": "Target service or logical grouping (e.g. 'dd-remote-web-home', 'dd-dev-server', or 'default' for cluster-wide values).",
            "type": "string"
          },
          "updatedAt": {
            "description": "ISO-8601 UTC instant at which the control plane wrote this version.",
            "type": "string"
          },
          "value": {
            "description": "Arbitrary JSON value. Producers SHOULD NOT embed secrets here; this payload is logged at every subscriber."
          },
          "version": {
            "description": "Monotonic per-entry version; the control plane bumps this whenever the value changes.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "env",
          "scope",
          "key",
          "version",
          "updatedAt"
        ],
        "type": "object"
      },
      "RuntimeConfigEnv": {
        "description": "Top-level namespace for every runtime-config record. Every Redis key, every snapshot, every subscriber registration is scoped to exactly one env. Stage and prod are isolated.",
        "enum": [
          "stage",
          "prod"
        ],
        "type": "string"
      },
      "RuntimeConfigErrorResponse": {
        "properties": {
          "error": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "error"
        ],
        "type": "object"
      },
      "RuntimeConfigResetResponse": {
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "type": "object"
      },
      "RuntimeConfigSnapshot": {
        "description": "The full set of active entries that apply to a given (env, scope) at a point in time. Subscribers receive this on every push.",
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/components/schemas/RuntimeConfigEntry"
            },
            "type": "array"
          },
          "env": {
            "$ref": "#/components/schemas/RuntimeConfigEnv"
          },
          "generatedAt": {
            "type": "string"
          },
          "scope": {
            "description": "Subscriber-targeted scope (e.g. 'dd-remote-web-home'). Use '*' for fan-out across all scopes.",
            "type": "string"
          },
          "snapshotVersion": {
            "description": "Monotonic env generation assigned by the control plane. Subscribers MAY ignore an older apply if they already store a greater version.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "env",
          "scope",
          "generatedAt",
          "snapshotVersion",
          "entries"
        ],
        "type": "object"
      },
      "RuntimeConfigSnapshotResponse": {
        "properties": {
          "appliedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "entries": {
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "env": {
            "type": [
              "string",
              "null"
            ]
          },
          "lastPushId": {
            "type": [
              "string",
              "null"
            ]
          },
          "lastReason": {
            "type": [
              "string",
              "null"
            ]
          },
          "scope": {
            "type": [
              "string",
              "null"
            ]
          },
          "service": {
            "type": [
              "string",
              "null"
            ]
          },
          "snapshotVersion": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "snapshotVersion",
          "entries"
        ],
        "type": "object"
      },
      "WebhookResponse": {
        "properties": {
          "action": {
            "type": [
              "string",
              "null"
            ]
          },
          "analysis_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "delivery": {
            "type": "string"
          },
          "event": {
            "type": [
              "string",
              "null"
            ]
          },
          "files_checked": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "repo": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "delivery"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "github_webhook_signature": {
        "description": "GitHub HMAC-SHA256 signature in the exact `sha256=<lowercase hex>` wire format. The SDK accepts a caller-supplied header and never receives or derives the webhook secret.",
        "in": "header",
        "name": "x-hub-signature-256",
        "type": "apiKey"
      },
      "runtime_config_server_auth": {
        "description": "Shared server-to-server secret configured through RUNTIME_CONFIG_SERVER_SECRET.",
        "in": "header",
        "name": "x-server-auth",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Typed GitHub webhook, operational, and runtime-configuration API for the formal-methods analysis service. The document is composed from the exact handlers and DTOs registered by the live Axum routers.",
    "title": "formal-methods-service-rs API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/docs": {
      "get": {
        "operationId": "getFormalMethodsPublicApiReference",
        "responses": {
          "200": {
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Interactive Scalar reference loaded from /openapi.json"
          }
        },
        "security": [
          {}
        ],
        "tags": [
          "documentation"
        ],
        "x-dd-auth": "public",
        "x-dd-visibility": "public"
      }
    },
    "/api/docs.json": {
      "get": {
        "operationId": "getFormalMethodsPublicOpenApiCompatibilityAlias",
        "responses": {
          "200": {
            "content": {
              "application/vnd.oai.openapi+json;version=3.1": {}
            },
            "description": "Compatibility alias for the fail-closed public OpenAPI 3.1 contract"
          }
        },
        "security": [
          {}
        ],
        "tags": [
          "documentation"
        ],
        "x-dd-auth": "public",
        "x-dd-visibility": "public"
      }
    },
    "/docs/api": {
      "get": {
        "operationId": "getFormalMethodsPublicApiReferenceCompatibilityAlias",
        "responses": {
          "200": {
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Compatibility alias for the public Scalar API reference"
          }
        },
        "security": [
          {}
        ],
        "tags": [
          "documentation"
        ],
        "x-dd-auth": "public",
        "x-dd-visibility": "public"
      }
    },
    "/health": {
      "get": {
        "operationId": "getFormalMethodsHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Process is alive"
          }
        },
        "security": [
          {}
        ],
        "tags": [
          "operations"
        ],
        "x-dd-auth": "cluster-network-policy",
        "x-dd-visibility": "internal"
      }
    },
    "/internal/runtime-config": {
      "get": {
        "operationId": "getRuntimeConfigSnapshot",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeConfigSnapshotResponse"
                }
              }
            },
            "description": "Current in-process runtime configuration snapshot"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeConfigErrorResponse"
                }
              }
            },
            "description": "Missing or invalid server authentication"
          }
        },
        "security": [
          {
            "runtime_config_server_auth": []
          }
        ],
        "tags": [
          "runtime-config"
        ],
        "x-dd-auth": "X-Server-Auth (RUNTIME_CONFIG_SERVER_SECRET)",
        "x-dd-visibility": "internal"
      }
    },
    "/internal/runtime-config/reset": {
      "post": {
        "operationId": "resetRuntimeConfigSnapshot",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeConfigResetResponse"
                }
              }
            },
            "description": "Runtime overrides cleared"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeConfigErrorResponse"
                }
              }
            },
            "description": "Missing or invalid server authentication"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeConfigErrorResponse"
                }
              }
            },
            "description": "Runtime-config authentication is not configured"
          }
        },
        "security": [
          {
            "runtime_config_server_auth": []
          }
        ],
        "tags": [
          "runtime-config"
        ],
        "x-dd-auth": "X-Server-Auth (RUNTIME_CONFIG_SERVER_SECRET)",
        "x-dd-visibility": "internal"
      }
    },
    "/internal/update-runtime-config": {
      "post": {
        "operationId": "applyRuntimeConfigSnapshot",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RuntimeConfigApplyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeConfigApplyResponse"
                }
              }
            },
            "description": "Snapshot applied or acknowledged as stale"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeConfigErrorResponse"
                }
              }
            },
            "description": "Missing or invalid server authentication"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeConfigErrorResponse"
                }
              }
            },
            "description": "Runtime-config authentication is not configured"
          }
        },
        "security": [
          {
            "runtime_config_server_auth": []
          }
        ],
        "tags": [
          "runtime-config"
        ],
        "x-dd-auth": "X-Server-Auth (RUNTIME_CONFIG_SERVER_SECRET)",
        "x-dd-visibility": "internal"
      }
    },
    "/metrics": {
      "get": {
        "operationId": "getFormalMethodsPrometheusMetrics",
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Prometheus text exposition"
          }
        },
        "security": [
          {}
        ],
        "tags": [
          "operations"
        ],
        "x-dd-auth": "cluster-network-policy",
        "x-dd-visibility": "internal"
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getFormalMethodsPublicOpenApi",
        "responses": {
          "200": {
            "content": {
              "application/vnd.oai.openapi+json;version=3.1": {}
            },
            "description": "Fail-closed public OpenAPI 3.1 contract"
          }
        },
        "security": [
          {}
        ],
        "tags": [
          "documentation"
        ],
        "x-dd-auth": "public",
        "x-dd-visibility": "public"
      }
    },
    "/ready": {
      "get": {
        "operationId": "getFormalMethodsReadiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Current analyzer and ingress readiness state"
          }
        },
        "security": [
          {}
        ],
        "tags": [
          "operations"
        ],
        "x-dd-auth": "cluster-network-policy",
        "x-dd-visibility": "internal"
      }
    },
    "/webhook/github": {
      "post": {
        "operationId": "receiveGitHubFormalMethodsWebhook",
        "parameters": [
          {
            "description": "GitHub HMAC-SHA256 signature in `sha256=<hex>` format",
            "in": "header",
            "name": "x-hub-signature-256",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "GitHub event name; `ping` and `pull_request` have explicit behavior",
            "in": "header",
            "name": "x-github-event",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "GitHub delivery identifier used for bounded deduplication",
            "in": "header",
            "name": "x-github-delivery",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PullRequestEvent"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookResponse"
                }
              }
            },
            "description": "GitHub ping acknowledged"
          },
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookResponse"
                }
              }
            },
            "description": "Event ignored, deduplicated, skipped, or accepted for asynchronous analysis"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Required header or pull-request payload is malformed"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "HMAC signature is missing or invalid"
          },
          "413": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Request body exceeds the 8 MiB ingress limit"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal webhook dispatch failure"
          }
        },
        "security": [
          {
            "github_webhook_signature": []
          }
        ],
        "tags": [
          "webhooks"
