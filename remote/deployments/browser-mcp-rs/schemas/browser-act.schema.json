{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://browser.oresoftware.dev/schemas/browser-act.schema.json",
  "title": "browser_act request",
  "description": "Starts or advances an isolated browser session by executing a small declarative action plan. Write-capable, open-world. Stops before CAPTCHA, MFA, secret entry, payment, signature, legal attestation, and unconfirmed irreversible submission.",
  "type": "object",
  "required": ["intent", "actions"],
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "type": "string",
      "maxLength": 200,
      "description": "Idempotency key (UUID recommended). Generated by the server if omitted. Reusing one with different arguments is rejected."
    },
    "session_id": {
      "type": "string",
      "maxLength": 200,
      "description": "Existing session to advance. Omit to start a new session; then the first action must be a 'start'."
    },
    "workflow_id": {
      "type": "string",
      "maxLength": 80,
      "description": "Selects a server-defined workflow allowlist. Callers cannot supply or widen domains."
    },
    "intent": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "description": "The revision you last observed. If it no longer matches, the call returns status 'revision_conflict' instead of acting on stale state."
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/action" }
    },
    "stop_when": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url_matches": { "type": "string" },
        "text_visible": { "type": "string" },
        "element_visible": { "$ref": "#/$defs/target" },
        "navigation_occurs": { "type": "boolean" },
        "validation_error_occurs": { "type": "boolean" }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_digest", "confirmed_revision", "user_explicitly_approved"],
      "properties": {
        "action_digest": { "type": "string" },
        "confirmed_revision": { "type": "integer", "minimum": 0 },
        "user_explicitly_approved": { "const": true }
      },
      "description": "Echo the pending_action.action_digest from a prior 'needs_confirmation' result to authorize one consequential action."
    },
    "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 60000 }
  },
  "$defs": {
    "value": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["literal"], "properties": { "literal": { "type": "string", "maxLength": 20000 } } },
        { "type": "object", "additionalProperties": false, "required": ["secret_ref"], "properties": { "secret_ref": { "type": "string", "description": "Server-side secret reference (e.g. vault://...). Resolved only inside the trusted worker; never returned or logged." } } }
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "description": "Prefer a ref returned by browser_state. Resolution order: ref, role+name, label, placeholder, visible_text, test_id, css_fallback. XPath and raw JavaScript are not supported.",
      "properties": {
        "ref": { "type": "string" },
        "role": { "type": "string" },
        "name": { "type": "string" },
        "label": { "type": "string" },
        "placeholder": { "type": "string" },
        "visible_text": { "type": "string" },
        "title": { "type": "string" },
        "test_id": { "type": "string" },
        "exact": { "type": "boolean" },
        "nth": { "type": "integer", "minimum": 0 },
        "frame_ref": { "type": "string" },
        "css_fallback": { "type": "string" }
      }
    },
    "action": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "start" }, "initial_url": { "type": "string", "format": "uri" }, "browser": { "enum": ["chromium", "firefox", "webkit", "selenium"] }, "viewport": { "type": "object", "properties": { "width": { "type": "integer" }, "height": { "type": "integer" } } }, "locale": { "type": "string" }, "timezone": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "url"], "properties": { "type": { "const": "goto" }, "url": { "type": "string", "format": "uri" }, "wait_until": { "enum": ["commit", "domcontentloaded", "load", "networkidle"] } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "target", "value"], "properties": { "type": { "const": "fill" }, "target": { "$ref": "#/$defs/target" }, "value": { "$ref": "#/$defs/value" }, "clear_first": { "type": "boolean" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "target", "value"], "properties": { "type": { "const": "type" }, "target": { "$ref": "#/$defs/target" }, "value": { "$ref": "#/$defs/value" }, "clear_first": { "type": "boolean" }, "delay_ms": { "type": "integer", "minimum": 0, "maximum": 250 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "fields"], "properties": { "type": { "const": "fill_form" }, "fields": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "object", "required": ["target", "value"], "properties": { "target": { "$ref": "#/$defs/target" }, "value": { "$ref": "#/$defs/value" } } } } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "target"], "properties": { "type": { "const": "click" }, "target": { "$ref": "#/$defs/target" }, "button": { "enum": ["left", "middle", "right"] } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "target"], "properties": { "type": { "const": "submit" }, "target": { "$ref": "#/$defs/target" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "target", "option"], "properties": { "type": { "const": "select" }, "target": { "$ref": "#/$defs/target" }, "option": { "oneOf": [ { "type": "object", "required": ["label"], "properties": { "label": { "type": "string" } } }, { "type": "object", "required": ["value"], "properties": { "value": { "type": "string" } } }, { "type": "object", "required": ["index"], "properties": { "index": { "type": "integer" } } } ] } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "target"], "properties": { "type": { "const": "check" }, "target": { "$ref": "#/$defs/target" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "target"], "properties": { "type": { "const": "uncheck" }, "target": { "$ref": "#/$defs/target" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "key"], "properties": { "type": { "const": "press" }, "target": { "$ref": "#/$defs/target" }, "key": { "type": "string" } } },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "target"],
          "oneOf": [
            { "required": ["file_token"], "not": { "required": ["inline_file"] } },
            { "required": ["inline_file"], "not": { "required": ["file_token"] } }
          ],
          "properties": {
            "type": { "const": "upload" },
            "target": { "$ref": "#/$defs/target" },
            "file_token": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
            "inline_file": {
              "type": "object",
              "additionalProperties": false,
              "required": ["file_name", "data_base64"],
              "properties": {
                "file_name": { "type": "string", "minLength": 1, "maxLength": 128 },
                "mime_type": { "type": "string", "minLength": 3, "maxLength": 100 },
                "data_base64": { "type": "string", "minLength": 4, "maxLength": 349528, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" }
              }
            }
          }
        },
        { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "scroll" }, "target": { "$ref": "#/$defs/target" }, "delta_x": { "type": "integer", "minimum": -5000, "maximum": 5000 }, "delta_y": { "type": "integer", "minimum": -5000, "maximum": 5000 } } },
        { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "screenshot" } } },
        { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "extract" }, "include": { "type": "array", "maxItems": 10, "items": { "enum": ["summary", "visible_text", "interactive_elements", "accessibility_snapshot", "forms", "validation_errors", "dialogs", "frames", "downloads", "network_failures"] } }, "max_visible_text_chars": { "type": "integer", "minimum": 200, "maximum": 30000 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "condition"], "properties": { "type": { "const": "wait" }, "condition": { "type": "object" } } },
        { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "back" } } },
        { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "forward" } } },
        { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "reload" } } },
        { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "close" } } }
      ]
    }
  }
}
