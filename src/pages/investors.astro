---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';

const primitives = [
  ['Locks & leases', 'Exclusive ownership with TTL expiry and fencing tokens so stale agents cannot keep acting.'],
  ['Semaphores & limits', 'Global concurrency and budget controls for browsers, GPUs, paid APIs, and fragile tools.'],
  ['Leader election', 'Exactly one active planner, supervisor, scheduler, reviewer, or release coordinator.'],
  ['Work claiming', 'Strongly consistent task ownership across retries, crashes, forks, and regional failover.'],
  ['Discovery & watches', 'Live registries and versioned shared state with push-based change streams.'],
  ['Fail-safe scheduling', 'Leader-elected recurring and one-shot jobs with durable history and recovery.'],
];

const uses = [
  ['Distributed systems', 'Operate locks, leases, elections, configuration, and service discovery without running ZooKeeper, Consul, or etcd.'],
  ['AI-agent fleets', 'Prevent duplicate or conflicting actions and coordinate scarce models, tools, budgets, and execution lanes.'],
  ['Multi-region control planes', 'Keep customer, operator, workflow, and infrastructure automation consistent through failures.'],
];

const deploymentGoals = [
  'Expand multi-region Kubernetes and Raft test environments',
  'Fund managed Postgres and distributed-SQL evaluation',
  'Increase automated testing, observability, and security validation',
  'Evaluate coding and inference models for agent orchestration',
  'Support design-partner integrations and production readiness',
];
---

<Layout
  title="Fiducia for investors and startup programs"
  description="Verified public evidence for Fiducia Cloud: an AI-native coordination and consensus control plane for distributed systems and autonomous-agent fleets."
>
  <main class="investor-page">
    <nav class="investor-nav">
      <a href={base} class="brand">Fiducia<span>.cloud</span></a>
      <div class="nav-links">
        <a href="https://github.com/fiducia-cloud">GitHub</a>
        <a href="https://linkedin.com/in/alexanderdmills">Founder</a>
        <a href="mailto:hello@fiducia.cloud" class="contact">Contact</a>
      </div>
    </nav>

    <section class="hero">
      <p class="eyebrow">Investor & startup-program evidence</p>
      <h1>The coordination layer for <span>autonomous systems</span></h1>
      <p class="lede">
        Fiducia is an AI-native successor to ZooKeeper, Consul, and etcd: a managed,
        Raft-replicated control plane for distributed locks, leases, semaphores,
        leader election, service discovery, strongly consistent work claiming,
        rate limiting, shared configuration, and fail-safe scheduling.
      </p>
      <div class="actions">
        <a href="mailto:hello@fiducia.cloud" class="primary">Talk with Fiducia</a>
        <a href="https://github.com/fiducia-cloud" class="secondary">Review the implementation</a>
      </div>
    </section>

    <section class="proof-grid" aria-label="Verified public evidence">
      <article>
        <strong>Public implementation</strong>
        <p>Active repositories for the data plane, control plane, authentication, routing, telemetry, clients, administration, and infrastructure.</p>
      </article>
      <article>
        <strong>Systems-first architecture</strong>
        <p>Sharded Raft groups, quorum commits, fencing tokens, renewable leases, and failure-aware control-plane automation.</p>
      </article>
      <article>
        <strong>Founder-led engineering</strong>
        <p>Alexander Mills is a software engineer with 13+ years of experience across distributed systems, cloud infrastructure, and developer platforms.</p>
      </article>
    </section>

    <section>
      <p class="eyebrow">The problem</p>
      <h2>Queues move work. They do not establish ownership.</h2>
      <p class="section-copy">
        Workflow engines model execution, but independent agents still need an authoritative
        answer to who owns a task, whether a lease is valid, which supervisor is active, and
        whether scarce tool or model capacity remains. Without those guarantees, retries and
        partial failures create duplicate, conflicting, or stale actions.
      </p>
    </section>

    <section>
      <p class="eyebrow">The product</p>
      <h2>Coordination primitives delivered through one API</h2>
      <div class="cards">
        {primitives.map(([title, body]) => (
          <article class="card">
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="comparison">
      <div>
        <p class="eyebrow">Why now</p>
        <h2>Agent fleets inherit distributed-systems failure modes</h2>
      </div>
      <div class="comparison-list">
        {uses.map(([title, body]) => (
          <article>
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="architecture">
      <p class="eyebrow">Architecture</p>
      <h2>Many Raft groups, one correctness guarantee</h2>
      <div class="architecture-flow">
        <div><span>1</span><strong>Shard</strong><p>Map each key, lock, lease, or schedule to a replicated group.</p></div>
        <div><span>2</span><strong>Elect</strong><p>Distribute leadership and write throughput across the cluster.</p></div>
        <div><span>3</span><strong>Commit</strong><p>Acknowledge operations only after durable majority replication.</p></div>
        <div><span>4</span><strong>Recover</strong><p>Re-place shards and restore service after node or region loss.</p></div>
      </div>
    </section>

    <section class="use-of-resources">
      <div>
        <p class="eyebrow">Use of capital & credits</p>
        <h2>Turn public infrastructure into a production service</h2>
      </div>
      <ul>
        {deploymentGoals.map((goal) => <li>{goal}</li>)}
      </ul>
    </section>

    <section class="facts">
      <p class="eyebrow">Verified company facts</p>
      <dl>
        <div><dt>Company / product</dt><dd>Fiducia Cloud</dd></div>
        <div><dt>Stage</dt><dd>Bootstrapped, active public implementation</dd></div>
        <div><dt>Official contact</dt><dd><a href="mailto:hello@fiducia.cloud">hello@fiducia.cloud</a></dd></div>
        <div><dt>Public code</dt><dd><a href="https://github.com/fiducia-cloud">github.com/fiducia-cloud</a></dd></div>
        <div><dt>Founder</dt><dd><a href="https://linkedin.com/in/alexanderdmills">Alexander Mills</a></dd></div>
        <div><dt>Machine-readable facts</dt><dd><a href={`${base}company-facts.json`}>company-facts.json</a></dd></div>
      </dl>
    </section>

    <footer>
      <strong>Fiducia.cloud</strong>
      <p>Consensus and coordination as a service for distributed systems and AI-agent fleets.</p>
      <a href="mailto:hello@fiducia.cloud">hello@fiducia.cloud</a>
    </footer>
  </main>
</Layout>

<style>
  :global(body) { background: #060914; color: #eef2ff; }
  :global(*) { box-sizing: border-box; }
  .investor-page { max-width: 1180px; margin: 0 auto; padding: 0 28px 72px; font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
  .investor-nav { min-height: 82px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(148,163,184,.16); }
  .brand { color: white; font-size: 20px; font-weight: 800; text-decoration: none; letter-spacing: -.03em; }
  .brand span { color: #a78bfa; }
  .nav-links { display: flex; align-items: center; gap: 22px; }
  .nav-links a { color: #cbd5e1; text-decoration: none; font-size: 14px; }
  .nav-links .contact { color: white; border: 1px solid rgba(167,139,250,.5); border-radius: 999px; padding: 10px 16px; }
  section { padding: 92px 0; border-bottom: 1px solid rgba(148,163,184,.13); }
  .hero { padding: 112px 0 88px; }
  .eyebrow { color: #a78bfa; font-size: 12px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; margin: 0 0 20px; }
  h1, h2, h3, p { margin-top: 0; }
  h1 { max-width: 930px; font-size: clamp(48px, 8vw, 92px); line-height: .98; letter-spacing: -.065em; margin-bottom: 32px; }
  h1 span { color: #a78bfa; }
  h2 { max-width: 820px; font-size: clamp(34px, 5vw, 60px); line-height: 1.04; letter-spacing: -.045em; margin-bottom: 28px; }
  h3 { font-size: 20px; letter-spacing: -.025em; margin-bottom: 10px; }
  p { color: #aab4c7; line-height: 1.7; }
  .lede, .section-copy { max-width: 820px; font-size: 20px; }
  .actions { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 34px; }
  .actions a { text-decoration: none; border-radius: 10px; padding: 14px 20px; font-weight: 750; }
  .primary { color: #0b0d16; background: #c4b5fd; }
  .secondary { color: #e2e8f0; border: 1px solid rgba(148,163,184,.28); }
  .proof-grid, .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .proof-grid { padding: 32px 0 76px; border-bottom: 1px solid rgba(148,163,184,.13); }
  .proof-grid article, .card, .comparison-list article, .architecture-flow div { background: rgba(15,23,42,.65); border: 1px solid rgba(148,163,184,.15); border-radius: 16px; padding: 24px; }
  .proof-grid strong { display: block; margin-bottom: 9px; }
  .proof-grid p, .card p, .comparison-list p, .architecture-flow p { margin-bottom: 0; font-size: 14px; }
  .comparison, .use-of-resources { display: grid; grid-template-columns: 1fr 1.15fr; gap: 70px; align-items: start; }
  .comparison-list { display: grid; gap: 14px; }
  .architecture-flow { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin-top: 42px; }
  .architecture-flow span { display: inline-grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: rgba(167,139,250,.18); color: #c4b5fd; font-weight: 800; margin-bottom: 24px; }
  .architecture-flow strong { display: block; margin-bottom: 8px; }
  .use-of-resources ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 12px; }
  .use-of-resources li { color: #dbe3f1; background: rgba(15,23,42,.6); border: 1px solid rgba(148,163,184,.15); border-radius: 12px; padding: 18px 20px; }
  .facts dl { margin: 38px 0 0; display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid rgba(148,163,184,.18); }
  .facts dl div { padding: 22px 0; border-bottom: 1px solid rgba(148,163,184,.18); display: grid; grid-template-columns: 190px 1fr; gap: 20px; }
  dt { color: #94a3b8; }
  dd { margin: 0; color: #e2e8f0; }
  dd a, footer a { color: #c4b5fd; }
  footer { padding: 64px 0 0; display: grid; grid-template-columns: 1fr 2fr 1fr; gap: 24px; align-items: start; }
  footer p { margin-bottom: 0; }
  footer a { justify-self: end; }
  @media (max-width: 850px) {
    .proof-grid, .cards, .architecture-flow { grid-template-columns: 1fr; }
    .comparison, .use-of-resources { grid-template-columns: 1fr; gap: 24px; }
    .facts dl { grid-template-columns: 1fr; }
    footer { grid-template-columns: 1fr; }
    footer a { justify-self: start; }
  }
  @media (max-width: 620px) {
    .investor-page { padding-inline: 18px; }
    .nav-links a:not(.contact) { display: none; }
    section { padding: 70px 0; }
    .hero { padding-top: 80px; }
    .facts dl div { grid-template-columns: 1fr; gap: 6px; }
  }
</style>
