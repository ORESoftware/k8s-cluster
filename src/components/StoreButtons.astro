---
// Reusable App Store + Google Play badge row. The final download section may
// also render desktop installers. Every URL is build-time configuration so the
// static site never guesses a store listing or serves an unverified artifact.
// Every configured store/download URL is validated as an absolute https URL
// before rendering; a non-https or unparseable value falls back to the
// "coming soon" badge instead of emitting an unusable or active href.
import { httpsBaseUrl, httpsUrl } from "../lib/external-url";

interface Props {
  align?: "start" | "center";
  desktop?: boolean;
}

const { align = "start", desktop = false } = Astro.props;
const APPLE_URL = httpsUrl(import.meta.env.PUBLIC_APP_STORE_URL);
const GOOGLE_URL = httpsUrl(import.meta.env.PUBLIC_PLAY_STORE_URL);
const DOWNLOAD_BASE_URL = httpsBaseUrl(import.meta.env.PUBLIC_DOWNLOAD_BASE_URL);

const desktopUrl = (explicitValue: string | undefined, relativePath: string) => {
  const explicit = httpsUrl(explicitValue);
  if (explicit) return explicit;
  return DOWNLOAD_BASE_URL ? `${DOWNLOAD_BASE_URL}/${relativePath}` : undefined;
};

const desktopDownloads = [
  {
    label: "Windows",
    detail: "64-bit installer",
    icon: "⊞",
    url: desktopUrl(import.meta.env.PUBLIC_DOWNLOAD_WINDOWS_URL, "latest/sonus-auris-windows-x64.exe"),
  },
  {
    label: "macOS",
    detail: "Universal DMG",
    icon: "⌘",
    url: desktopUrl(import.meta.env.PUBLIC_DOWNLOAD_MACOS_URL, "latest/sonus-auris-macos-universal.dmg"),
  },
  {
    label: "Linux",
    detail: "x86-64 Debian package",
    icon: "🐧",
    url: desktopUrl(import.meta.env.PUBLIC_DOWNLOAD_LINUX_URL, "latest/sonus-auris-linux-x86_64.deb"),
  },
];
---

<div class={`store-row ${align}`}>
  {APPLE_URL ? (
  <a class="store-badge" href={APPLE_URL} rel="noopener noreferrer" aria-label="Download on the App Store">
    <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
      <path
        fill="currentColor"
        d="M16.37 12.58c-.02-2.2 1.8-3.26 1.88-3.31-1.02-1.5-2.62-1.7-3.19-1.73-1.36-.14-2.65.8-3.34.8-.69 0-1.75-.78-2.88-.76-1.48.02-2.85.86-3.61 2.19-1.54 2.67-.39 6.62 1.11 8.79.73 1.06 1.6 2.25 2.74 2.21 1.1-.05 1.51-.71 2.84-.71 1.32 0 1.7.71 2.86.69 1.18-.02 1.93-1.08 2.65-2.15.84-1.23 1.18-2.42 1.2-2.48-.03-.01-2.3-.88-2.32-3.5zM14.2 6.1c.6-.74 1.01-1.76.9-2.78-.87.04-1.93.58-2.56 1.31-.56.65-1.05 1.69-.92 2.69.97.08 1.97-.49 2.58-1.22z"
      ></path>
    </svg>
    <span><small>Download on the</small><strong>App Store</strong></span>
  </a>
  ) : (
  <span class="store-badge is-coming" aria-label="Coming soon to the App Store">
    <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
      <path fill="currentColor" d="M16.37 12.58c-.02-2.2 1.8-3.26 1.88-3.31-1.02-1.5-2.62-1.7-3.19-1.73-1.36-.14-2.65.8-3.34.8-.69 0-1.75-.78-2.88-.76-1.48.02-2.85.86-3.61 2.19-1.54 2.67-.39 6.62 1.11 8.79.73 1.06 1.6 2.25 2.74 2.21 1.1-.05 1.51-.71 2.84-.71 1.32 0 1.7.71 2.86.69 1.18-.02 1.93-1.08 2.65-2.15.84-1.23 1.18-2.42 1.2-2.48-.03-.01-2.3-.88-2.32-3.5zM14.2 6.1c.6-.74 1.01-1.76.9-2.78-.87.04-1.93.58-2.56 1.31-.56.65-1.05 1.69-.92 2.69.97.08 1.97-.49 2.58-1.22z"></path>
    </svg>
    <span><small>Coming to the</small><strong>App Store</strong></span>
  </span>
  )}

  {GOOGLE_URL ? (
  <a class="store-badge" href={GOOGLE_URL} rel="noopener noreferrer" aria-label="Get it on Google Play">
    <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
      <path fill="#34c585" d="M3.6 2.3 13.4 12 3.6 21.7c-.36-.2-.6-.58-.6-1.05V3.35c0-.47.24-.85.6-1.05z"></path>
      <path fill="#fd7e14" d="M17.3 8.2 14.9 12l2.4 3.8 3-1.7c.86-.5.86-1.7 0-2.2l-3-1.7z"></path>
      <path fill="#1faa6c" d="M3.6 2.3c.18-.1.4-.13.65-.05L16 8.5l-1.6 3.5L3.6 2.3z"></path>
      <path fill="#e8590c" d="M3.6 21.7 14.4 12 16 15.5 4.25 21.75c-.25.08-.47.05-.65-.05z"></path>
    </svg>
    <span><small>Get it on</small><strong>Google Play</strong></span>
  </a>
  ) : (
  <span class="store-badge is-coming" aria-label="Coming soon to Google Play">
    <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
      <path fill="#34c585" d="M3.6 2.3 13.4 12 3.6 21.7c-.36-.2-.6-.58-.6-1.05V3.35c0-.47.24-.85.6-1.05z"></path>
      <path fill="#fd7e14" d="M17.3 8.2 14.9 12l2.4 3.8 3-1.7c.86-.5.86-1.7 0-2.2l-3-1.7z"></path>
      <path fill="#1faa6c" d="M3.6 2.3c.18-.1.4-.13.65-.05L16 8.5l-1.6 3.5L3.6 2.3z"></path>
      <path fill="#e8590c" d="M3.6 21.7 14.4 12 16 15.5 4.25 21.75c-.25.08-.47.05-.65-.05z"></path>
    </svg>
    <span><small>Coming to</small><strong>Google Play</strong></span>
  </span>
  )}
</div>

{desktop && (
  <div class={`desktop-downloads ${align}`} aria-label="Desktop downloads">
    <p>Desktop installers</p>
    <div class="desktop-row">
      {desktopDownloads.map((download) => download.url ? (
        <a class="desktop-badge" href={download.url} rel="noopener noreferrer">
          <span class="platform-icon" aria-hidden="true">{download.icon}</span>
          <span><strong>{download.label}</strong><small>{download.detail}</small></span>
        </a>
      ) : (
        <span class="desktop-badge is-coming" aria-label={`${download.label} installer coming soon`}>
          <span class="platform-icon" aria-hidden="true">{download.icon}</span>
          <span><strong>{download.label}</strong><small>Installer coming soon</small></span>
        </span>
      ))}
    </div>
  </div>
)}

<style>
  .store-row,
  .desktop-row {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .store-row.center,
  .desktop-downloads.center .desktop-row {
    justify-content: center;
  }
  .store-badge,
  .desktop-badge {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    padding: 10px 20px 10px 16px;
    border-radius: 14px;
    background: #0c2a22;
    color: #fff;
    box-shadow: var(--shadow-sm);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .store-badge:hover,
  .desktop-badge:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .store-badge.is-coming,
  .desktop-badge.is-coming {
    cursor: default;
    opacity: 0.72;
  }
  .store-badge.is-coming:hover,
  .desktop-badge.is-coming:hover {
    transform: none;
    box-shadow: var(--shadow-sm);
  }
  .store-badge span,
  .desktop-badge > span:last-child {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
    text-align: left;
  }
  .store-badge small,
  .desktop-badge small {
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.8;
  }
  .store-badge strong,
  .desktop-badge strong {
    font-size: 1.05rem;
    font-weight: 800;
  }
  .desktop-downloads {
    width: 100%;
    margin-top: 24px;
  }
  .desktop-downloads > p {
    margin: 0 0 10px;
    color: rgba(255, 253, 248, 0.8);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .desktop-downloads.center > p {
    text-align: center;
  }
  .desktop-badge {
    min-width: 175px;
    background: rgba(255, 253, 248, 0.12);
    border: 1px solid rgba(255, 253, 248, 0.22);
  }
  .platform-icon {
    width: 28px;
    text-align: center;
    font-size: 1.4rem;
  }
</style>
