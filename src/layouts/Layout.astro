---
// Base HTML shell for every page: sets <head> metadata (title, description, OG
// tags, favicon), canonical URLs, and the /fiducia base URL.
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Fiducia — Consensus & Coordination as a Service',
  description = 'Fiducia is a Raft-based consensus and coordination platform for distributed systems and AI-agent fleets: locks, semaphores, task claims, rate limiting, shared state, elections, KV watches, and reliable cron.',
} = Astro.props;

// Normalize BASE_URL to always end in exactly one slash (Astro returns it
// without a trailing slash when `base` is configured without one).
const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';
const site = Astro.site ?? new URL('https://fiducia.cloud');
const investorPath = `${base}investors/`.replace(/\/{2,}/g, '/');
const isInvestorEvidence = title === 'Fiducia for investors and startup programs';
const canonicalPath = isInvestorEvidence ? investorPath : Astro.url.pathname;
const canonicalUrl = new URL(canonicalPath, site).toString();
const companyFactsUrl = new URL(`${base}company-facts.json`.replace(/\/{2,}/g, '/'), site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Privacy hardening: don't leak full URLs/paths to third-party origins.
         HTTP security headers (CSP, X-Content-Type-Options, X-Frame-Options,
         Referrer-Policy) are set by the serving layer (fiducia-customer.rs). -->
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070b1a" />
    <meta name="fiducia:consensus-model" content="crash-fault tolerant (CFT), not Byzantine" />
    <link rel="canonical" href={canonicalUrl} />
    {isInvestorEvidence && (
      <link
        rel="alternate"
        type="application/json"
        title="Verified Fiducia Cloud company facts"
        href={companyFactsUrl}
      />
    )}
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
  </head>
  <body>
    <slot />
  </body>
</html>
