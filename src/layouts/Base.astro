---
// Base HTML document layout. Renders <head> (title, description, favicon,
// Open Graph tags, self-hosted font preload) and a <body><slot/> for page
// content. Public asset URLs are prefixed with the GitHub Pages base path.
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Sonus Auris — A Dashcam for Audio",
  description = "Sonus Auris is the always-on audio dashcam. Never lose that killer riff again, and keep a private, secure record when you need one. Open-source app, privacy-first.",
} = Astro.props;

// Public assets must be prefixed with the deploy base path so links work both
// at the production root and on preview subpaths. Astro's root base is `/`,
// so normalize trailing slashes before appending an asset path.
const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const ogImage = new URL(`${base}/og.svg`, Astro.site);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
// GitHub Pages ignores `public/_headers`, so the response-header policy in that
// file is never actually served (see the warning at the top of it). These two
// `<meta>` equivalents are the part of that policy a static host *can* enforce,
// and they are emitted for production builds only so `astro dev`'s HMR client
// still loads. Directives that are invalid in `<meta>` (frame-ancestors, HSTS,
// Permissions-Policy) still require a real header in front of the origin.
//
// The site ships no client JavaScript at all, hence `script-src 'none'`.
// `style-src` needs 'unsafe-inline' for Astro's scoped <style> blocks and the
// inline @font-face rule below.
const contentSecurityPolicy = [
  "default-src 'self'",
  "base-uri 'self'",
  "script-src 'none'",
  "style-src 'self' 'unsafe-inline'",
  "font-src 'self'",
  "img-src 'self' data:",
  "connect-src 'self'",
  "form-action 'self'",
  "frame-src 'none'",
  "object-src 'none'",
  "upgrade-insecure-requests",
].join("; ");
const enforceMetaCsp = import.meta.env.PROD;

const fontFaceCss = `@font-face {
  font-family: "Baloo 2";
  font-style: normal;
  font-weight: 500 800;
  font-display: swap;
  src: url("${base}/fonts/baloo2.woff2") format("woff2");
}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {enforceMetaCsp && (
      <meta http-equiv="Content-Security-Policy" content={contentSecurityPolicy} />
    )}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="theme-color" content="#1faa6c" />

    <!-- Fun rounded brand font — self-hosted under the configured base path,
         so no third-party request and a tighter CSP. -->
    <link
      rel="preload"
      href={`${base}/fonts/baloo2.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <style is:inline set:html={fontFaceCss}></style>
  </head>
  <body>
    <slot />
  </body>
</html>
