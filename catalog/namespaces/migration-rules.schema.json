{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oresoftware.com/k8s-cluster/namespace-migration-rules.schema.json",
  "title": "ORESoftware legacy namespace migration rules",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "$schema": {"const": "./migration-rules.schema.json"},
    "apiVersion": {"const": "oresoftware.dev/v1alpha1"},
    "kind": {"const": "NamespaceMigrationRuleSet"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fallbackOwner", "rules"],
      "properties": {
        "fallbackOwner": {"const": "unclassified"},
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/rule"}
        }
      }
    }
  },
  "$defs": {
    "nullableString": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {"enum": ["exact", "prefix", "regex"]},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "priority",
        "system",
        "match",
        "owner",
        "status",
        "targetTemplate",
        "environment",
        "workload",
        "consumers",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "priority": {"type": "integer", "minimum": 0, "maximum": 10000},
        "system": {
          "enum": [
            "slash-namespace",
            "metadata-key",
            "host-path",
            "source-package",
            "generated-package"
          ]
        },
        "match": {"$ref": "#/$defs/match"},
        "owner": {"type": "string", "minLength": 1},
        "status": {
          "enum": ["classified", "review-required", "unclassified"]
        },
        "targetTemplate": {"$ref": "#/$defs/nullableString"},
        "environment": {"$ref": "#/$defs/nullableString"},
        "workload": {"$ref": "#/$defs/nullableString"},
        "consumers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "notes": {"type": "string", "minLength": 1}
      }
    }
  }
}
