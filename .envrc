# direnv: auto-load the Nix dev shell from .nix/ when entering this directory.
watch_file .nix/flake.nix
watch_file .nix/flake.lock
use flake ./.nix

# Secrets from env/enc are deliberately NOT auto-loaded. An auto-loaded secret
# lands in the environment of every subprocess started from this directory —
# package-manager hooks, editors, agents. Scope it to the command that needs it:
#     just env-run local cargo run
# If a tool insists on a real file, `just env-decrypt` writes env/dec/*.env
# (gitignored, mode 0600) and the tool parses that itself.
