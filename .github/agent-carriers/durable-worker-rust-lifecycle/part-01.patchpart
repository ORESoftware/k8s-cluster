+        .fail_step(
+            step_id,
+            StepFailure {
+                lease,
+                code: failure.code,
+                message: failure.message,
+                retryable: failure.retryable,
+            },
+        )
+        .await
+    {
+        Ok(()) => TaskOutcome::Failed,
+        Err(error) if error.is_lease_lost() => TaskOutcome::LeaseLost,
+        Err(_) => TaskOutcome::ProtocolError,
