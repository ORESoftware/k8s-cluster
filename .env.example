HOST=0.0.0.0
PORT=8121
RUST_LOG=push_notification_server=info

# HTTP ingestion fails closed unless an authenticator is explicitly enabled.
# Shared-secret mode is migration-only; prefer workload identity/service JWT in production.
ENABLE_SHARED_SECRET_AUTH=false
# Minimum 32 characters. Store in an external secret and send as Authorization: Bearer <value>.
SERVER_AUTH_SECRET=

# Optional SendGrid email lane. SENDGRID_FROM_EMAIL must be a verified sender.
# Use a least-privilege API key with only the Mail Send permission.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=
# global (api.sendgrid.com) or eu (api.eu.sendgrid.com)
SENDGRID_REGION=global
# SendGrid accepts and validates messages but does not deliver them in sandbox mode.
SENDGRID_SANDBOX_MODE=false

# Optional Twilio SMS lane. Configure exactly one credential mode.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Preferred for production rotation instead of the primary Auth Token:
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Configure exactly one sender. Messaging Services are preferred for sender pools,
# compliance, and regional routing; TWILIO_FROM_NUMBER is the simpler fallback.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
# Optional HTTPS callback handled by a signature-verifying webhook receiver.
TWILIO_STATUS_CALLBACK_URL=
# Twilio accepts values from 1 through 36000 seconds.
TWILIO_VALIDITY_PERIOD_SECONDS=3600

# Durable JetStream push ingestion. Omit NATS_URL to disable NATS while retaining HTTP.
NATS_URL=
NATS_PUSH_JOB_STREAM=PUSH_JOBS_V1
NATS_PUSH_RESULT_STREAM=PUSH_RESULTS_V1
NATS_PUSH_DEAD_STREAM=PUSH_DEAD_V1
NATS_PUSH_JOB_SUBJECT=push.jobs.v1
NATS_PUSH_RESULT_SUBJECT=push.results.v1
NATS_PUSH_DEAD_SUBJECT=push.dead.v1
NATS_PUSH_CONSUMER=push-notification-server-v1
NATS_PUSH_ACK_WAIT_SECONDS=120
NATS_PUSH_NAK_DELAY_SECONDS=15
NATS_PUSH_MAX_DELIVER=5
NATS_PUSH_MAX_PAYLOAD_BYTES=524288
NATS_PUSH_MAX_CONCURRENCY=32
# NATS account/subject ACLs are the primary authorization boundary. Enable the
# envelope secret only during migrations requiring defense in depth.
ENABLE_NATS_ENVELOPE_AUTH=false
NATS_SHARED_SECRET=

# FCM is enabled only when the service loads valid server-side credentials.
# Store the complete JSON document in an external secret; never commit it.
FCM_SERVICE_ACCOUNT_JSON=
# Optional override when project_id is not present in the service-account JSON.
FCM_PROJECT_ID=

# APNs token authentication. Store the .p8 value in an external secret.
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
# Use a separate provider configuration/connection pool for sandbox targets.
APNS_ENVIRONMENT=production

# Expo Push works without an access token for projects that do not enable enhanced security.
# Store this optional project access token in an external secret when configured.
EXPO_ACCESS_TOKEN=

# Browser Web Push/VAPID. Store the P-256 private key PEM in an external secret.
# The service uses direct ECE encryption and ES256 VAPID signing from the locked graph.
# The Web Push graph intentionally contains no unused RSA signing implementation.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:push@example.com
WEBPUSH_TTL_SECONDS=43200
# Empty uses the strict built-in browser push-service allowlist. A comma-separated
# override is safer than '*'. '*' enables weaker any-public-host mode with DNS vetting.
WEBPUSH_ALLOWED_HOSTS=

# No provider credential or sender identity is accepted from HTTP or NATS producer requests.
