# Sonus Auris backend — example environment. Copy to `.env` and fill in real
# values. NEVER put real secrets in this file; only `.env` (gitignored) holds them.

# --- Supabase identity (token verification) ----------------------------------
# The backend only *verifies* Supabase access tokens. With the new asymmetric
# (publishable/secret) key model it needs the project URL; the JWKS URL and
# issuer are derived from it automatically. No key is required just to verify.
SOUND_RECORDER_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Optional explicit overrides (otherwise derived from the URL above):
# SOUND_RECORDER_SUPABASE_JWKS_URL=https://YOUR-PROJECT-REF.supabase.co/auth/v1/.well-known/jwks.json
# SOUND_RECORDER_SUPABASE_ISSUER=https://YOUR-PROJECT-REF.supabase.co/auth/v1
# SOUND_RECORDER_SUPABASE_AUDIENCE=authenticated
# Legacy HS256 shared secret — leave UNSET when using asymmetric (JWKS) keys.
# SOUND_RECORDER_SUPABASE_JWT_SECRET=

# Supabase service-role key: privileged, server-only. Required for
# DELETE /api/mobile/v1/account to remove the Supabase Auth user. Never ship
# this in the mobile app; only the backend may hold it.
# SOUND_RECORDER_SUPABASE_SERVICE_ROLE_KEY=

# --- S3 storage --------------------------------------------------------------
SOUND_RECORDER_S3_BUCKET=
SOUND_RECORDER_S3_REGION=
SOUND_RECORDER_S3_KEY_PREFIX=
# SOUND_RECORDER_S3_ENDPOINT=        # for S3-compatible stores

# --- Cloud OAuth token sealing (Google Drive / OneDrive) ---------------------
# Base64 of 32 random bytes. Required only for server-managed cloud links.
# SOUND_RECORDER_CLOUD_TOKEN_ENCRYPTION_KEY=
# Comma-separated allow-list of exact OAuth redirectUri values the backend will
# initiate a cloud-link flow with (defense-in-depth open-redirect pin; the OAuth
# provider also enforces its own registered redirects). Empty = accept any
# https / loopback-http redirect. Entries must be https (or loopback http for
# dev) — the same scheme rule applies before the allow-list. Set to your real
# hosted OAuth callback(s) in production.
# SOUND_RECORDER_OAUTH_REDIRECT_ALLOWLIST=https://app.sonusauris.com/oauth/callback,https://app.sonusauris.com/oauth/onedrive

# --- Device auth & registration ----------------------------------------------
# Pepper mixed into the device-token hash. MUST be set in production and kept
# stable — without it tokens do not survive a process restart, and rotating it
# invalidates every issued device token. Use a long random value.
# SOUND_RECORDER_DEVICE_TOKEN_PEPPER=
# Shared bearer for trusted server-to-server device registration. When set,
# registration requires either a valid Supabase token or this bearer.
# SOUND_RECORDER_REGISTRATION_BEARER=
# Allow anonymous device registration (account keyed to the install id only).
# Leave false unless you intend an open-registration deployment.
# SOUND_RECORDER_ALLOW_PUBLIC_DEVICE_REGISTRATION=false
# Shared secret guarding the /internal/* maintenance routes (retention sweep,
# cloud-copy drain). Required for those routes to do anything.
# SOUND_RECORDER_SERVER_AUTH_SECRET=

# --- Rate limiting -----------------------------------------------------------
# Per-client request budget per 60s window (defense-in-depth against burst
# abuse / cheap DoS). Default 240; set 0 to disable. The limiter is per-replica.
# SOUND_RECORDER_RATE_LIMIT_PER_MINUTE=240
# Trust the leftmost X-Forwarded-For hop as the client key (correct behind a
# trusted reverse proxy / k8s ingress). Set false if the service is directly
# internet-exposed, so clients cannot spoof their bucket key via the header.
# SOUND_RECORDER_RATE_LIMIT_TRUST_FORWARDED_FOR=true
