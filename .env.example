# Store listing URLs. Leave unset until each public listing exists.
PUBLIC_APP_STORE_URL=
PUBLIC_PLAY_STORE_URL=

# Preferred desktop distribution: a Cloudflare R2 custom domain. The release
# workflow publishes versioned immutable objects plus no-cache aliases under
# /latest. Set either this base URL or any per-platform override below.
# Read by StoreButtons.astro for the stable, reviewed installers.
PUBLIC_DOWNLOAD_BASE_URL=https://downloads.sonusauris.app
PUBLIC_DOWNLOAD_WINDOWS_URL=
PUBLIC_DOWNLOAD_MACOS_URL=
PUBLIC_DOWNLOAD_LINUX_URL=

# Alpha desktop builds, split by runtime, published beneath a stable
# `.../desktop/<runtime>-alpha/latest` prefix. Read by DesktopDownloads.astro.
# Distinct from the stable per-OS installers above: these track the pre-release
# Rust and Flutter desktop clients. The generic value is retained as the
# backwards-compatible Rust fallback; prefer the runtime-specific values for
# new deployments. Omit until the bucket and custom download domain are live.
PUBLIC_DESKTOP_DOWNLOAD_BASE_URL=
PUBLIC_RUST_DESKTOP_DOWNLOAD_BASE_URL=https://downloads.sonusauris.app/desktop/alpha/latest
PUBLIC_FLUTTER_DESKTOP_DOWNLOAD_BASE_URL=https://downloads.sonusauris.app/desktop/flutter-alpha/latest

# Optional restricted Google Drive folder for invited testers during early
# alpha, used as a temporary fallback while the R2 download host is activated.
PUBLIC_DESKTOP_TESTERS_URL=
