# Sonus Auris backend — example environment. Copy to `.env` and fill in real
# values. NEVER put real secrets in this file; only `.env` (gitignored) holds them.

# --- Supabase identity (token verification) ----------------------------------
# The backend only *verifies* Supabase access tokens. With the new asymmetric
# (publishable/secret) key model it needs the project URL; the JWKS URL and
# issuer are derived from it automatically. JWT verification itself needs no
# API key, but the typed user-data routes need a publishable key to call the
# Supabase Data API with the user's JWT and preserve RLS.
SOUND_RECORDER_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SOUND_RECORDER_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Optional explicit overrides (otherwise derived from the URL above):
# SOUND_RECORDER_SUPABASE_JWKS_URL=https://YOUR-PROJECT-REF.supabase.co/auth/v1/.well-known/jwks.json
# SOUND_RECORDER_SUPABASE_ISSUER=https://YOUR-PROJECT-REF.supabase.co/auth/v1
# SOUND_RECORDER_SUPABASE_AUDIENCE=authenticated
# Legacy HS256 shared secret — leave UNSET when using asymmetric (JWKS) keys.
# SOUND_RECORDER_SUPABASE_JWT_SECRET=

# Supabase service-role key: privileged, server-only. Required for
# DELETE /api/mobile/v1/account to remove the Supabase Auth user. Never ship
# this in the mobile app; only the backend may hold it.
# SOUND_RECORDER_SUPABASE_SERVICE_ROLE_KEY=
# Supabase accounts, RLS data reads, and Auth deletion are core production
# capabilities. Keep strict readiness enabled; set false only for isolated
# anonymous/local development. Boolean values must be true/false, 1/0, yes/no,
# or on/off; typos make readiness fail instead of silently disabling a guard.
# SOUND_RECORDER_REQUIRE_SUPABASE=true

# --- S3 storage --------------------------------------------------------------
SOUND_RECORDER_S3_BUCKET=
SOUND_RECORDER_S3_REGION=
SOUND_RECORDER_S3_KEY_PREFIX=
# AWS/custom S3 must be explicitly confirmed unversioned. Versioned and
# versioning-suspended buckets are rejected because deleting a key only creates
# a delete marker and does not physically erase prior object versions. R2 has
# no object versioning and is treated as unversioned automatically.
SOUND_RECORDER_S3_VERSIONING_MODE=unversioned
# Native AWS credentials may use the standard AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN chain (IAM roles are preferred).
# Explicit service-scoped aliases are also supported:
# SOUND_RECORDER_S3_ACCESS_KEY_ID=
# SOUND_RECORDER_S3_SECRET_ACCESS_KEY=
# SOUND_RECORDER_S3_SESSION_TOKEN=
# SOUND_RECORDER_S3_ENDPOINT=        # for S3-compatible stores
# SOUND_RECORDER_S3_FORCE_PATH_STYLE=false
# SOUND_RECORDER_S3_SERVER_SIDE_ENCRYPTION=auto  # auto | aes256 | none
# SOUND_RECORDER_S3_MAX_ATTEMPTS=3
# Existing sentinel inside SOUND_RECORDER_S3_KEY_PREFIX. Production /readyz
# requires this live, bounded HeadObject probe. It deliberately does not call
# HeadBucket/ListBucket, so the principal needs object access but no list grant.
# SOUND_RECORDER_S3_READINESS_OBJECT_KEY=sound-recorder/segments/.readiness
# Isolated development only: permits a no-I/O signing probe when no sentinel is
# configured. Never use this as proof that a production bucket is reachable.
# SOUND_RECORDER_ALLOW_SIGNING_ONLY_STORAGE_READINESS=false

# New rows carry a non-secret fingerprint of backend/endpoint/region/bucket.
# Existing pre-fingerprint rows fail readiness by default. Set this true only
# temporarily after proving every unmarked row belongs to this exact backend;
# backfill the fingerprint shown by /healthz, then return it to false before any
# AWS/R2/backend cutover.
# SOUND_RECORDER_ALLOW_UNMARKED_STORAGE_HISTORY=false
# Required when the flag above is true; must exactly equal the current
# storageBackendFingerprint from /healthz. A later backend change therefore
# invalidates the acknowledgment automatically.
# SOUND_RECORDER_UNMARKED_STORAGE_HISTORY_FINGERPRINT=

# Cloudflare R2 can be selected as the primary S3-compatible store by setting
# its account id (the endpoint is derived and signing region becomes `auto`).
# The R2 aliases below also accept the generic R2_* names emitted by the shared
# infrastructure templates. An explicit
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com (or
# SOUND_RECORDER_S3_ENDPOINT with the same value) also works. R2_REGION must be
# `auto`. Do not set AES256: R2 encrypts at rest but rejects that S3 request
# header.
# SOUND_RECORDER_R2_ACCOUNT_ID=
# SOUND_RECORDER_R2_ACCESS_KEY_ID=
# SOUND_RECORDER_R2_SECRET_ACCESS_KEY=
# SOUND_RECORDER_R2_SESSION_TOKEN=
# SOUND_RECORDER_R2_BUCKET=
# R2_REGION=auto
# R2_ENDPOINT=https://YOUR-CLOUDFLARE-ACCOUNT-ID.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=sonus-auris-audio

# --- Cloud OAuth token sealing (Google Drive / OneDrive) ---------------------
# Base64 of 32 random bytes. Required only for server-managed cloud links.
# SOUND_RECORDER_CLOUD_TOKEN_ENCRYPTION_KEY=
# Comma-separated allow-list of exact OAuth redirectUri values the backend will
# initiate a cloud-link flow with (defense-in-depth open-redirect pin; the OAuth
# provider also enforces its own registered redirects). Empty = accept any
# https / loopback-http redirect. Entries must be https (or loopback http for
# dev) — the same scheme rule applies before the allow-list. Set to your real
# hosted OAuth callback(s) in production.
# SOUND_RECORDER_OAUTH_REDIRECT_ALLOWLIST=https://app.sonusauris.com/oauth/callback,https://app.sonusauris.com/oauth/onedrive

# --- Device auth & registration ----------------------------------------------
# Pepper mixed into the device-token hash. MUST be set in production and kept
# stable — without it tokens do not survive a process restart, and rotating it
# invalidates every issued device token. Use a long random value.
# SOUND_RECORDER_DEVICE_TOKEN_PEPPER=
# Shared bearer for trusted server-to-server device registration. When set,
# registration requires either a valid Supabase token or this bearer.
# SOUND_RECORDER_REGISTRATION_BEARER=
# Allow anonymous device registration (account keyed to the install id only).
# Leave false unless you intend an open-registration deployment.
# SOUND_RECORDER_ALLOW_PUBLIC_DEVICE_REGISTRATION=false
# Shared secret guarding the /internal/* maintenance routes (retention sweep,
# cloud-copy drain). Required for those routes to do anything.
# SOUND_RECORDER_SERVER_AUTH_SECRET=

# --- Rate limiting -----------------------------------------------------------
# Per-client request budget per 60s window (defense-in-depth against burst
# abuse / cheap DoS). Default 240; set 0 to disable. The limiter is per-replica.
# SOUND_RECORDER_RATE_LIMIT_PER_MINUTE=240
# Trust the leftmost X-Forwarded-For hop as the client key (correct behind a
# trusted reverse proxy / k8s ingress). Set false if the service is directly
# internet-exposed, so clients cannot spoof their bucket key via the header.
# SOUND_RECORDER_RATE_LIMIT_TRUST_FORWARDED_FOR=false
