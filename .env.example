# Safe placeholder values for local development.
# Real secrets live in ignored files such as env/.prod.env or .env.local.

SUPABASE_PROJECT_REF=replace-me
SUPABASE_PROJECT_ID=replace-me
SUPABASE_PROJECT_REGION=eu-central-1
SUPABASE_URL=https://replace-me.supabase.co
SUPABASE_AUTH_ISSUER=https://replace-me.supabase.co/auth/v1
SUPABASE_AUTH_AUDIENCE=authenticated
SUPABASE_AUTH_ALLOW_REMOTE_USERINFO=true
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Customer portal auth surfaces.
CUSTOMER_PORTAL_URL=https://portal.replace-me.example
CUSTOMER_ALLOWED_ORIGINS=https://portal.replace-me.example
SUPABASE_AUTH_SITE_URL=https://portal.replace-me.example
SUPABASE_AUTH_EMAIL_REDIRECT_TO=https://portal.replace-me.example/auth/callback
SUPABASE_AUTH_PASSWORD_ENABLED=true
SUPABASE_AUTH_EMAIL_OTP_ENABLED=true
SUPABASE_AUTH_TOTP_ENABLED=true
SUPABASE_AUTH_PASSKEY_ENABLED=true
WEBAUTHN_RP_ID=portal.replace-me.example
WEBAUTHN_RP_NAME=Fiducia
WEBAUTHN_ORIGIN=https://portal.replace-me.example
TOTP_ISSUER=Fiducia
SESSION_COOKIE_NAME=fiducia_session
SESSION_TTL_SECONDS=604800

# Customer API keys and idempotent request handling.
CUSTOMER_API_KEY_PREFIX=fdc_live_
CUSTOMER_API_KEY_PEPPER=replace-me-with-secret-manager-value
CUSTOMER_API_KEY_HASH_ALGORITHM=sha256
IDEMPOTENCY_KEY_HEADER=Idempotency-Key
IDEMPOTENCY_STORE_URL=https://node.replace-me.example
IDEMPOTENCY_CLAIM_TIMEOUT_MS=2000
IDEMPOTENCY_RECORD_TTL_SECONDS=86400

# Transactional email placeholders.
EMAIL_FROM=no-reply@replace-me.example
SMTP_HOST=smtp.replace-me.example
SMTP_PORT=587
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me-with-secret-manager-value
