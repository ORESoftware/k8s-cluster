        "alias": "memebank-api",
        "repository": "memebank/mbk-rest-api",
        "required": true,
        "role": "api",
        "zed_dependency": false
      },
      "memebank-pwa": {
        "alias": "memebank-pwa",
        "repository": "memebank/mbk-pwa",
        "required": true,
        "role": "ui",
        "zed_dependency": false
      }
