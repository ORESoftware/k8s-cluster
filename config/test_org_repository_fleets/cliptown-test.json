        "repository": "cliptown/cliptown-rust-backend.rs",
        "required": true,
        "role": "api",
        "zed_dependency": false
      },
      "cli": {
        "alias": "cli",
        "repository": "cliptown/cliptown-cli",
        "required": true,
        "role": "cli",
        "zed_dependency": false
      },
      "clients": {
        "alias": "clients",
        "repository": "cliptown/cliptown-clients",
        "required": true,
        "role": "clients",
        "zed_dependency": true
      },
      "extension": {
        "alias": "extension",
        "repository": "cliptown/cliptown-extension",
        "required": true,
        "role": "ui",
        "zed_dependency": false
      },
      "flutter": {
        "alias": "flutter",
        "repository": "cliptown/cliptown-flutter",
        "required": true,
        "role": "ui",
        "zed_dependency": false
      },
      "interfaces": {
        "alias": "interfaces",
        "repository": "cliptown/cliptown-interfaces",
        "required": true,
        "role": "interfaces",
        "zed_dependency": true
      },
