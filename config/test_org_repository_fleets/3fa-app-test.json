        "repository": "3FA-app/threefa-monorepo",
        "required": true,
        "role": "app",
        "zed_dependency": false
      },
      "backend": {
        "alias": "backend",
        "repository": "3FA-app/3fa-backend.rs",
        "required": true,
        "role": "api",
        "zed_dependency": false
      },
      "clients": {
        "alias": "clients",
        "repository": "3FA-app/3fa-clients",
        "required": true,
        "role": "clients",
        "zed_dependency": true
      },
      "desktop": {
        "alias": "desktop",
        "repository": "3FA-app/3FA-desktop.rs",
        "required": true,
        "role": "desktop",
        "zed_dependency": false
      },
      "extension": {
        "alias": "extension",
        "repository": "3FA-app/3fa-app-chrome-extension",
        "required": true,
        "role": "ui",
        "zed_dependency": false
