#!/usr/bin/env bash
set -euo pipefail

# Convenience launcher: drops you into (or runs a command in) the repo's Nix dev
# shell defined by .nix/flake.nix.

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

if [[ $# -gt 0 ]]; then
  exec nix develop "$repo_root/.nix" --command "$@"
fi

exec nix develop "$repo_root/.nix"
