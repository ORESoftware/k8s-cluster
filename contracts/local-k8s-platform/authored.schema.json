{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ores.local-k8s-platform.authored.schema.json",
  "$defs": {
    "RuntimeKind": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "RuntimeKind",
      "type": "string",
      "enum": ["colima-kind", "docker-kind", "multipass-k3s"]
    },
    "CpuArchitecture": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "CpuArchitecture",
      "type": "string",
      "enum": ["arm64", "amd64"]
    },
    "ResourceClass": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "ResourceClass",
      "type": "string",
      "enum": ["compact", "standard", "large"]
    },
    "ClusterTopology": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "ClusterTopology",
      "type": "string",
      "enum": ["single-node", "three-node"]
    },
    "CloudMutationPolicy": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "CloudMutationPolicy",
      "type": "string",
      "enum": ["denied"]
    },
    "EvidenceSource": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "EvidenceSource",
      "type": "string",
      "enum": ["github-actions-kind", "local-kind"]
    },
    "RuntimeProfile": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "RuntimeProfile",
      "type": "object",
      "properties": {
        "schema": { "type": "string" },
        "name": { "type": "string" },
        "runtime": { "$ref": "RuntimeKind" },
        "architecture": { "$ref": "CpuArchitecture" },
        "resourceClass": { "$ref": "ResourceClass" },
        "topology": { "$ref": "ClusterTopology" },
        "kubernetesVersion": { "type": "string" },
        "runtimeArtifact": { "type": "string" },
        "cloudMutationPolicy": { "$ref": "CloudMutationPolicy" },
        "cloudWrites": { "type": "boolean" }
      },
      "required": [
        "schema",
        "name",
        "runtime",
        "architecture",
        "resourceClass",
        "topology",
        "kubernetesVersion",
        "runtimeArtifact",
        "cloudMutationPolicy",
        "cloudWrites"
      ],
      "unevaluatedProperties": false
    },
    "RuntimeEvidence": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "RuntimeEvidence",
      "type": "object",
      "properties": {
        "schema": { "type": "string" },
        "profileName": { "type": "string" },
        "profileSha256": { "type": "string" },
        "evidenceSource": { "$ref": "EvidenceSource" },
        "sourceSha": { "type": "string" },
        "runtime": { "$ref": "RuntimeKind" },
        "architecture": { "$ref": "CpuArchitecture" },
        "resourceClass": { "$ref": "ResourceClass" },
        "topology": { "$ref": "ClusterTopology" },
        "kubernetesVersion": { "type": "string" },
        "runtimeArtifact": { "type": "string" },
        "apiServerReady": { "type": "boolean" },
        "serverAdmissionPassed": { "type": "boolean" },
        "rbacListPods": { "type": "boolean" },
        "rbacGetSecrets": { "type": "boolean" },
        "providerWrites": { "type": "boolean" },
        "secretInputs": { "type": "boolean" },
        "cloudMutationPolicy": { "$ref": "CloudMutationPolicy" },
        "cloudWrites": { "type": "boolean" }
      },
      "required": [
        "schema",
        "profileName",
        "profileSha256",
        "evidenceSource",
        "sourceSha",
        "runtime",
        "architecture",
        "resourceClass",
        "topology",
        "kubernetesVersion",
        "runtimeArtifact",
        "apiServerReady",
        "serverAdmissionPassed",
        "rbacListPods",
        "rbacGetSecrets",
        "providerWrites",
        "secretInputs",
        "cloudMutationPolicy",
        "cloudWrites"
      ],
      "unevaluatedProperties": false
    }
  }
}
