{
  "schema_version": 1,
  "repository": "shared-auth/shared-auth-server.rs",
  "procedure": "docs/FORMAL_REVIEW_PROCEDURE.md",
  "obligations": [
    {
      "id": "AUTH_ROTATE",
      "kind": "safety",
      "statement": "One accepted refresh atomically consumes the old token and installs exactly one fresh token.",
      "trigger_paths": [
        "src/**",
        "db/**"
      ],
      "model": "formal/review-procedure/model.py",
      "evidence": [
        "bounded session model",
        "database rotation tests"
      ],
      "commands": [
        "python3 formal/review-procedure/model.py",
        "cargo test --all-targets --locked"
      ],
      "assumptions": [
        "the database transaction is serializable at the application boundary"
      ],
      "bounded": true
    },
    {
      "id": "AUTH_REPLAY",
      "kind": "safety",
      "statement": "A consumed or non-current refresh token is rejected without mutating the session.",
      "trigger_paths": [
        "src/**"
      ],
      "model": "formal/review-procedure/model.py",
      "evidence": [
        "bounded session model",
        "replay regression tests"
      ],
      "commands": [
        "python3 formal/review-procedure/model.py",
        "cargo test --all-targets --locked"
      ],
      "assumptions": [
        "token hashes are collision resistant"
      ],
      "bounded": true
    },
    {
      "id": "AUTH_REVOKE",
      "kind": "safety",
      "statement": "After logout or administrative revocation no token can reactivate the session.",
      "trigger_paths": [
        "src/**",
        "db/**"
      ],
      "model": "formal/review-procedure/model.py",
      "evidence": [
        "bounded session model",
        "logout and revocation tests"
      ],
      "commands": [
        "python3 formal/review-procedure/model.py",
        "cargo test --all-targets --locked"
      ],
      "assumptions": [
        "revocation reads observe authoritative PostgreSQL state"
      ],
      "bounded": true
    },
    {
      "id": "AUTH_IDENTITY",
      "kind": "safety",
      "statement": "External accounts are linked only by configured authority, tenant, and provider subject—not email equality.",
      "trigger_paths": [
        "src/**",
        "db/**"
      ],
      "model": null,
      "evidence": [
        "identity-linking tests",
        "schema uniqueness constraints"
      ],
      "commands": [
        "python3 formal/review-procedure/check.py",
        "cargo test --all-targets --locked"
      ],
      "assumptions": [
        "provider subject and issuer verification are trustworthy"
      ],
      "bounded": false
    },
    {
      "id": "AUTH_CLAIMS",
      "kind": "refinement",
      "statement": "Accepted and issued JWTs enforce the configured issuer, audience, algorithm, expiry, not-before, and session provenance.",
      "trigger_paths": [
        "src/**"
      ],
      "model": null,
      "evidence": [
        "JWT boundary tests",
        "JWKS algorithm allow-list tests"
      ],
      "commands": [
        "python3 formal/review-procedure/check.py",
        "cargo test --all-targets --locked"
      ],
      "assumptions": [
        "cryptographic libraries satisfy their documented contracts"
      ],
      "bounded": false
    }
  ]
}
